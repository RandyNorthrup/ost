{
  "name": "ost-fluid-loader",
  "version": "2.118.1",
  "private": true,
  "description": "The open-source Fluid Framework pieces OST's Loop page host uses, bundled as fluid-loader.js (docs/spec/loop-host.md).",
  "license": "MIT",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=iife --global-name=OstFluid --minify --target=es2022 --platform=browser --legal-comments=eof --outfile=fluid-loader.js"
  },
  "dependencies": {
    "@fluidframework/container-loader": "2.118.1",
    "@fluidframework/odsp-driver": "2.118.1",
    "@fluidframework/synthesize": "2.118.1"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}

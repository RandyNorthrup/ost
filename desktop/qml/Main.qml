    // (Meet now, not joined) for its mic. Quits 10 s after a call ends, or
    // after `--headset-stay=<s>` (default 600).
    Timer {
        id: headsetTest
        readonly property string mode: (Qt.application.arguments.find(a => a.startsWith("--headset-test")) || "").replace("--headset-test", "").replace("=", "")
        readonly property bool on: Qt.application.arguments.some(a => a.startsWith("--headset-test"))
        readonly property int stay: parseInt((Qt.application.arguments.find(a => a.startsWith("--headset-stay=")) || "=600").split("=")[1])
        running: on && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property int ended: -1
        property bool hadCall: false
        onTriggered: {
            const st = step++
            if (st === 0) { rail.current = "settings"; settingsView.pageForTest("devices") }
            else if (st === 2) window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/headset-devices.png"))
            else if (st === 3 && mode === "prejoin") preJoin.openMeetNow("", "OST headset test")
            if (st === 0) console.warn("HEADSET me", backend.userMri)
            // --headset-transfer-at=<step>: Teams' transfer prompt, if it's
            // up then, captured and answered "Transfer controls";
            // --headset-take-at=<step>: Devices' "Transfer controls to this
            // app". Pictures go to <--headset-shots prefix>-….png.
            const shots = (Qt.application.arguments.find(a => a.startsWith("--headset-shots=")) || "=/tmp/act/headset").split("=")[1]
            const at = name => parseInt((Qt.application.arguments.find(a => a.startsWith(name + "=")) || "=-1").split("=")[1])
            if (st === at("--headset-transfer-at")) {
                console.warn("HEADSET-PROMPT", hidTransferDialog.visible ? "shown" : "not shown", JSON.stringify(hidTransferDialog.title), JSON.stringify(hidTransferDialog.body), JSON.stringify(hidTransferDialog.confirmText))
                if (hidTransferDialog.visible) window.contentItem.grabToImage(r => {
                    r.saveToFile(shots + "-prompt.png")
                    hidTransferDialog.close(); hidTransferDialog.confirmed()
                    console.warn("HEADSET-PROMPT answered Transfer controls")
                })
            }
            if (st === at("--headset-take-at")) {
                window.contentItem.grabToImage(r => {
                    r.saveToFile(shots + "-before-take.png")
                    console.warn("HEADSET-TAKE", settingsView.transferControlsForTest() ? "transferred" : "button disabled")
                })
            }
            if (st > 0 && st % 5 === 0) console.warn("HEADSET-BUTTON usable", settingsView.transferButtonUsableForTest())
            // --headset-mute-steps=<n>,<n>…: OST's own mute toggled at
            // those steps of a connected call (the headset follows it).
            const muteSteps = (Qt.application.arguments.find(a => a.startsWith("--headset-mute-steps=")) || "=").split("=")[1].split(",").filter(s => s !== "").map(Number)
            if (muteSteps.indexOf(st) >= 0 && backend.callState === "connected") { backend.toggleMute(); console.warn("HEADSET-APP-MUTE toggled") }
            if (st === at("--headset-transfer-at") + 3 || st === at("--headset-take-at") + 3) window.contentItem.grabToImage(r => r.saveToFile(shots + "-after-" + st + ".png"))
            console.warn("HEADSET", st, backend.headsetStatus(), "call", JSON.stringify(backend.callState), "muted", backend.callMuted, "held", backend.callHeld, "prejoin", preJoin.visible, "prejoinMic", preJoin.micOn)
            if (backend.callState !== "" && backend.callState !== "ended") hadCall = true
            if (hadCall && ended < 0 && (backend.callState === "ended" || backend.callState === "")) ended = st
            if ((ended >= 0 && st > ended + 5) || st * 2 > stay) { console.warn("HEADSET done"); Qt.quit() }
        }
    }
    Connections {
        target: backend
        enabled: headsetTest.on
        function onCallStateChanged() { console.warn("HEADSET-CALL", backend.callState, "muted", backend.callMuted) }
        function onCallMutedChanged() { console.warn("HEADSET-MUTE", backend.callMuted) }
        function onHeadsetTeamsButton(what) { console.warn("HEADSET-TEAMS-BUTTON", what, "rail", rail.current) }
    }
    Timer {
        running: Qt.application.arguments.indexOf("--about-test") >= 0 && backend.signedIn
        interval: 3000; repeat: true
        property int step: 0
        onTriggered: {
            const st = step++
            if (st === 0) { rail.current = "settings"; settingsView.pageForTest("about"); backend.checkForUpdates() }
            else if (st === 2) { console.warn("ABOUT", backend.updateJson, JSON.stringify(settingsView.cardRowsForTest("Version"))); window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/about-latest.png")) }
            else if (st === 3) backend.updateJson = JSON.stringify({ state: "available", checkedAt: Date.now(), latest: "0.2.0", url: "https://github.com/RandyNorthrup/ost/releases" })
            else if (st === 4) { console.warn("ABOUT", backend.updateJson); window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/about-update.png")) }
            else if (st > 5) Qt.quit()
        }
    }

    // --recognition-states: Settings ▸ Recognition in each of Teams'
    // states (set locally, nothing sent), as CARDS and CARDROWS lines.
    Timer {
        running: Qt.application.arguments.indexOf("--recognition-states") >= 0 && backend.signedIn
        interval: 1500; repeat: true
        property int step: 0
        readonly property var states: [
            { loaded: true },
            { loaded: true, passiveVoice: true },
            { loaded: true, voice: true },
            { loaded: true, voice: true, passiveVoice: true, face: true }]
        onTriggered: {
            const st = step++
            if (st === 0) { rail.current = "settings"; settingsView.pageForTest("recognition") }
            else if (st < 4) {}
            else if (st - 3 <= states.length * 2) {
                const k = st - 3
                const i = Math.floor((k - 1) / 2)
                if (k % 2 === 1) backend.recognitionJson = JSON.stringify(states[i])
                else {
                    console.warn("CARDS recognition-" + i, JSON.stringify(settingsView.cardsForTest()))
                    console.warn("CARDROWS voice-" + i, JSON.stringify(settingsView.cardRowsForTest("Voice Recognition")))
                    console.warn("CARDROWS face-" + i, JSON.stringify(settingsView.cardRowsForTest("Face Recognition")))
                    window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/recst-" + i + ".png"))
                }
            } else Qt.quit()
        }
    }

    // --recognition-test=<photo.jpg>,<voice.wav>: Settings ▸ Recognition,
    // then Teams' face capture fed that photo and the voice capture fed that
    // 16 kHz WAV, through to the completion step; pictures of each step and
    // CARDS lines. Enrolls those profiles (remove them afterwards).
    Timer {
        id: recognitionTest
        readonly property var files: (Qt.application.arguments.find(a => a.startsWith("--recognition-test=")) || "").slice(19).split(",")
        running: files[0] !== "" && backend.signedIn
        interval: 2500; repeat: true
        property int step: 0
        property int wait: 0
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/rec-" + n + ".png")) }
        onTriggered: {
            const face = settingsView.faceDialogForTest(), voice = settingsView.voiceDialogForTest()
            const st = step++
            if (st === 0) { rail.current = "settings"; settingsView.pageForTest("recognition") }
            else if (st === 2) { console.warn("CARDS recognition", JSON.stringify(settingsView.cardsForTest()), backend.recognitionJson); shot("page") }
            else if (st === 3) { face.testPhoto = files[0]; settingsView.startRecognition("face") }
            else if (st === 4) shot("face")
            else if (st === 5) { face.started = true; face.countdownForTest() }
            else if (st === 6) shot("face-count")
            else if (st >= 7 && st < 40 && !face.finished) { if (st % 4 === 0) console.warn("RECOG face", face.pose, face.error, face.learning) }
            else if (st >= 7 && st < 60 && face.finished && wait === 0) { wait = st; shot("face-done") }
            else if (wait && st === wait + 1) { face.close(); voice.testWav = files[1]; settingsView.startRecognition("voice") }
            else if (wait && st === wait + 2) shot("voice")
            else if (wait && st === wait + 3) voice.start()
            else if (wait && st === wait + 4) voice.end()
            else if (wait && st > wait + 4 && st < wait + 30 && !voice.finished) { if (st % 3 === 0) console.warn("RECOG voice", voice.phase, voice.errorCode) }
            else if (wait && voice.finished && st < wait + 40) { shot("voice-done"); voice.close(); backend.loadRecognition(); step = 200 }
            else if (st === 202) { console.warn("CARDS recognition-after", JSON.stringify(settingsView.cardsForTest()), backend.recognitionJson); shot("page-after") }
            else if (st >= 204 || st === 60) Qt.quit()
        }
    }

    // --notif-banner-live-test: the first real chat banner is answered from the
    // banner: BANNER-LIVE logs it, 4 s later it reacts with a heart and
    // sends a quick reply naming --notif-banner-live-test=<text>.
    Connections {
        target: backend
        enabled: Qt.application.arguments.some(a => a.startsWith("--notif-banner-live-test"))
        property bool done: false
        function onBannerRequested(json) {
            const t = JSON.parse(json)
            console.warn("BANNER-LIVE", json)
            if (done || t.kind !== "standard" || !t.quickReply) return
            done = true
            liveBannerTimer.chat = t.chatId
            liveBannerTimer.message = t.messageId
            liveBannerTimer.banner = t.id
            liveBannerTimer.start()
        }
    }
    Timer {
        id: liveBannerTimer
        property string chat
        property string message
        property string banner
        interval: 4000
        onTriggered: {
            const text = (Qt.application.arguments.find(a => a.startsWith("--notif-banner-live-test=")) || "").slice(25) || "OST quick reply"
            backend.bannerReact(chat, message, "heart")
            backend.bannerReply(chat, text)
            banners.dismiss(banner)
            console.warn("BANNER-LIVE answered", chat, message)
        }
    }

    // --notif-banner-test: Teams' notification banners, step by step every 3 s
    // (photograph the screen at each BANNERS line): an incoming call, a
    // chat message with its quick reply, an @mention and a meeting that started
    // (BR, Comfy); then the same Compact in the top left, then the top
    // right. BANNERS lines give each card's place in the window. Puts the
    // position and size settings back as they were.
    Timer {
        id: bannerTest
        running: Qt.application.arguments.some(a => a === "--notif-banner-test" || a === "--notif-banner-test=hold")
        interval: 3000; repeat: true
        property int step: 0
        property string corner0
        property string size0
        function fill() {
            banners.add({ id: "call", kind: "call", title: "OST Test 2", senderMri: "8:orgid:9edcc62f-2f4b-4f55-bbf9-02c7cbaadbb5", silent: true })
            banners.add({ id: "t1", kind: "standard", title: "OST Test 2", text: "Here is a longer message that needs two lines to show all of it in the banner, and then some more", chatId: "19:x@unq.gbl.spaces", messageId: "1", senderMri: "8:orgid:9edcc62f-2f4b-4f55-bbf9-02c7cbaadbb5", senderName: "OST Test 2", quickReply: true, seconds: 300, silent: true })
            banners.add({ id: "t2", kind: "msn", title: "OST group test", text: "OST Test 2 started a meeting", chatId: "19:y@thread.v2", senderMri: "8:orgid:9edcc62f-2f4b-4f55-bbf9-02c7cbaadbb5", senderName: "OST Test 2", seconds: 300, silent: true, actions: [{ id: "join", label: qsTr("Join") }, { id: "message", label: qsTr("Message") }] })
        }
        function report(tag) {
            const cards = []
            for (let i = 0; i < banners.contentItem.children.length; i++) {
                const col = banners.contentItem.children[i]
                for (let j = 0; j < (col.children ? col.children.length : 0); j++) {
                    const c = col.children[j]
                    if (c.toast) cards.push([c.toast.id, Math.round(c.mapToItem(banners.contentItem, 0, 0).x * 10) / 10, Math.round(c.mapToItem(banners.contentItem, 0, 0).y * 10) / 10, c.width, c.height])
                }
            }
            console.warn("BANNERS", tag, banners.corner, banners.compact, banners.width, banners.height, JSON.stringify(cards))
            banners.contentItem.grabToImage(r => r.saveToFile("/tmp/act/banner-" + tag + ".png"))
        }
        onTriggered: {
            const st = step++
            const clear = () => { for (const id of Object.keys(banners.toasts)) banners.dismiss(id) }
            // --notif-banner-test=hold: show them (BR, Comfy) and report every
            // 3 s for 45 s, for clicking at them.
            if (Qt.application.arguments.indexOf("--notif-banner-test=hold") >= 0 && st > 0) {
                if (st < 16) { report("hold-" + st); return }
                clear(); backend.setSetting("notificationCorner", corner0); backend.setSetting("notificationSize", size0); Qt.quit(); return
            }
            if (st === 0) {
                corner0 = backend.setting("notificationCorner"); size0 = backend.setting("notificationSize")
                backend.setSetting("notificationCorner", "BR"); backend.setSetting("notificationSize", "COMFY")
                fill()
            } else if (st === 1) report("br-comfy")
            else if (st === 2) banners.add({ id: "t3", kind: "standard", title: "OST Test 2 @mentioned you", subtitle: "OST group test", text: "@OST Test 1 have a look", urgent: true, chatId: "19:y@thread.v2", messageId: "2", senderMri: "8:orgid:9edcc62f-2f4b-4f55-bbf9-02c7cbaadbb5", senderName: "OST Test 2", seconds: 300, silent: true })
            else if (st === 3) report("br-comfy-3")
            else if (st === 4) { clear(); backend.setSetting("notificationCorner", "TL"); backend.setSetting("notificationSize", "COMPACT"); fill() }
            else if (st === 5) report("tl-compact")
            else if (st === 6) { clear(); backend.setSetting("notificationCorner", "BL"); fill() }
            else if (st === 7) report("bl-compact")
            else if (st === 8) { clear(); backend.setSetting("notificationCorner", "TR"); backend.setSetting("notificationSize", "COMFY"); fill() }
            else if (st === 9) report("tr-comfy")
            else if (st === 10) { clear(); backend.setSetting("notificationCorner", corner0); backend.setSetting("notificationSize", size0) }
            else Qt.quit()
        }
    }

    // --cards-test: every Settings page's cards as CARDS lines (geometry
    // compared with Teams'). Changes nothing.
    Timer {
        running: Qt.application.arguments.some(a => a === "--cards-test" || a.startsWith("--cards-test=")) && backend.signedIn && backend.orgName.length > 0
        interval: 1500; repeat: true
        property int step: 0
        readonly property var keys: settingsView.pages.map(p => p.key).concat(["about"])
        onTriggered: {
            const i = Math.floor(step / 2)
            if (i >= keys.length) {
                // General again, its Editor card once its options load.
                if (step === 2 * keys.length) settingsView.pageForTest("general")
                else if (step === 2 * keys.length + 6) { console.warn("CARDS general-late", JSON.stringify(settingsView.cardsForTest())); settingsView.scrollToForTest(1700); }
                else if (step === 2 * keys.length + 7) window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-editor.png")))
                else if (step > 2 * keys.length + 8) { Qt.quit(); return }
                step++; return
            }
            if (step % 2 === 0) { rail.current = "settings"; settingsView.pageForTest(keys[i]) }
            else {
                console.warn("CARDS", keys[i], JSON.stringify(settingsView.cardsForTest()))
                // --cards-test=<title>: that card's rows too.
                const rows = (Qt.application.arguments.find(a => a.startsWith("--cards-test=")) || "").slice(13)
                if (rows) console.warn("CARDROWS", keys[i], JSON.stringify(settingsView.cardRowsForTest(rows)))
            }
            step++
        }
    }

    // --test-call-test: Settings ▸ Devices ▸ Make a test call (TASK-0141):
    // the Devices page, Teams' test call in the call window (the Echo
    // bot's prompt, your recording played back), then the results screen,
    // its Device settings pane and Close. Leaves the call itself after
    // 120 s if the bot hasn't ended it. Logs TESTCALL lines; pictures
    // -devices, -call, -report, -report-devices.
    Timer {
        running: Qt.application.arguments.indexOf("--test-call-test") >= 0 && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property int ended: -1
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + n + ".png"))) }
        function callShot(n) { callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + n + ".png"))) }
        onTriggered: {
            console.warn("TESTCALL", step, "state", backend.callState, "test", backend.callTest, "muted", backend.callMuted, "camera", backend.callCameraOn, "report", backend.callTestReport, "vi", backend.voiceIsolationJson, backend.voiceIsolationStats())
            if (step === 0) { rail.current = "settings"; settingsView.pageForTest("devices") }
            else if (step === 1) shot("devices")
            else if (step === 2) backend.makeTestCall()
            else if (step === 10) callShot("call")
            // --test-call-copilot: Copilot in the test call (a calling
            // scenario): its question captured, then dismissed.
            else if (step === 12 && Qt.application.arguments.indexOf("--test-call-copilot") >= 0) callWindow.runControl("MeetingCollabButton")
            else if (step === 13 && Qt.application.arguments.indexOf("--test-call-copilot") >= 0) {
                const a = callWindow.copilotAskForTest()
                console.warn("TESTCALL copilot ask", a.visible, a.Accessible.name, "copilotOnly", callWindow.copilotOnly, "calling", callWindow.callingScenario)
                callShot("copilot-ask")
            } else if (step === 14 && Qt.application.arguments.indexOf("--test-call-copilot") >= 0) callWindow.copilotAskForTest().visible = false
            else if (step === 60 && backend.callState !== "ended" && backend.callState !== "") { console.warn("TESTCALL leaving"); backend.hangUp() }
            if (step > 2 && ended < 0 && backend.callState === "ended") ended = step
            if (ended >= 0) {
                if (step === ended + 1) callShot("report")
                else if (step === ended + 2) callWindow.testReportForTest().showDevices = true
                else if (step === ended + 3) callShot("report-devices")
                else if (step === ended + 4) { callWindow.testReportForTest().closed(); }
                else if (step === ended + 5) { console.warn("TESTCALL closed, state", JSON.stringify(backend.callState), "window", callWindow.visible); Qt.quit(); return }
            }
            if (step > 90) { console.warn("TESTCALL gave up"); Qt.quit(); return }
            step++
        }
    }

    // --camera-controls-test: Settings ▸ Devices ▸ Video settings'
    // "Automatically adjust camera controls" (TASK-0158) on the chosen
    // camera (choose a test camera: the page shows its preview): the row,
    // the switch off (the camera's automatic controls off, its V4L2 values
    // logged), "Open camera settings" (OST's camera settings with the
    // camera's controls), one control changed and restored, the switch on
    // again. --camera-controls-test=<device> does the same on that camera
    // without opening the page (no pictures: a real camera's image is
    // never shown or captured). CAMCTL lines; -cam-*.png.
    Timer {
        readonly property string arg: Qt.application.arguments.find(a => a.startsWith("--camera-controls-test")) || ""
        readonly property string device: arg.indexOf("=") > 0 ? arg.slice(arg.indexOf("=") + 1) : ""
        running: arg !== "" && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property var before: null
        function shot(n) { if (!device) window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + n + ".png"))) }
        function path() { return device || settingsView.cameraForTest().camera }
        function log(what) {
            const list = JSON.parse(backend.cameraControlsJson(path()) || "[]")
            console.warn("CAMCTL", what, "auto", JSON.stringify(backend.cameraAutoControls(path())), "setting", JSON.stringify(backend.setting("autoCameraControls")),
                "controls", JSON.stringify(list.map(c => c.name + "=" + c.value + (c.autoId ? (c.auto ? "(auto)" : "(manual)") : "") + (c.inactive ? "[inactive]" : ""))))
            return list
        }
        onTriggered: {
            if (step === 0) { if (!device) { rail.current = "settings"; settingsView.pageForTest("devices") } }
            else if (step === 2) { if (!device) settingsView.scrollToCardForTest("video"); log("start") }
            else if (step === 3) { if (!device) console.warn("CAMCTL row", JSON.stringify(settingsView.cameraForTest())); shot("cam-start") }
            else if (step === 4) { if (device) backend.setCameraAutoControls(device, false); else settingsView.toggleAutoCameraForTest(false) }
            else if (step === 5) { before = log("switch off"); if (!device) console.warn("CAMCTL row", JSON.stringify(settingsView.cameraForTest())); shot("cam-off") }
            else if (step === 6) { if (!device) settingsView.openCameraSettingsForTest() }
            else if (step === 7) shot("cam-settings")
            else if (step === 8) {
                const b = (before || []).find(c => c.kind === "int" && !c.inactive && !c.auto)
                if (b) { console.warn("CAMCTL set", b.name, "to", b.min + Math.round((b.max - b.min) * 0.75), "ok", backend.setCameraControl(path(), b.id, b.min + Math.round((b.max - b.min) * 0.75))) }
            }
            else if (step === 9) { log("changed"); shot("cam-settings-changed") }
            else if (step === 10) {
                const b = (before || []).find(c => c.kind === "int" && !c.inactive && !c.auto)
                if (b) console.warn("CAMCTL restore", b.name, b.value, backend.setCameraControl(path(), b.id, b.value))
                if (!device) settingsView.cameraSettingsForTest().close()
            }
            else if (step === 11) { if (device) backend.setCameraAutoControls(device, true); else settingsView.toggleAutoCameraForTest(true) }
            else if (step === 12) { log("switch on"); if (!device) console.warn("CAMCTL row", JSON.stringify(settingsView.cameraForTest())); shot("cam-on") }
            else if (step >= 13) { Qt.quit(); return }
            step++
        }
    }

    // --spatial-audio-test: Settings ▸ Devices' Spatial audio row (TASK-0157):
    // its state and place (SPATIAL lines, -spatial-devices.png); with
    // --spatial-audio-on / --spatial-audio-off it is turned on or off
    // first. With --join-test in a meeting the call window logs the tiles'
    // places every 5 s (SPATIAL tiles).
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--spatial-audio-test")) && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        /// 2 s steps since the meeting connected.
        property int callStep: 0
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + n + ".png"))) }
        onTriggered: {
            const inCall = backend.callState === "connected"
            if (inCall) {
                // --spatial-audio-admit: let in everyone waiting (our test
                // guests), as "This isn't a bot" ticked.
                const lobby = JSON.parse(backend.callLobbyJson || "[]")
                if (Qt.application.arguments.indexOf("--spatial-audio-admit") >= 0 && lobby.length) {
                    console.warn("SPATIAL admitting", JSON.stringify(lobby.map(p => p.name)))
                    lobby.forEach(p => backend.admitFromLobby(p.id, p.name, true))
                }
                // --spatial-audio-hide-me: Teams' Hide for me (the others
                // side by side); --spatial-audio-layout=speaker: Speaker view.
                if (Qt.application.arguments.indexOf("--spatial-audio-hide-me") >= 0) callWindow.hideMe = true
                const lay = (Qt.application.arguments.find(a => a.startsWith("--spatial-audio-layout=")) || "").slice(23)
                if (lay) callWindow.layout = lay
                // --spatial-audio-toggle=on@<step>,off@<step>: turn Spatial
                // audio on or off mid-meeting at those 2 s steps (as its
                // switch in Settings ▸ Devices does).
                const toggles = (Qt.application.arguments.find(a => a.startsWith("--spatial-audio-toggle=")) || "").slice(23)
                toggles.split(",").filter(x => x.indexOf("@") > 0).forEach(x => {
                    if (parseInt(x.split("@")[1]) === callStep) {
                        console.warn("SPATIAL toggle", x.split("@")[0], "at call step", callStep)
                        backend.setSetting("spatialAudio", x.split("@")[0] === "on" ? "true" : "false")
                    }
                })
                console.warn("SPATIAL tiles", callStep, JSON.stringify(callWindow.spatialForTest()), "speaking", backend.callSpeakingJson)
                if (step % 10 === 0) callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-spatial-call.png")))
                step++; callStep++; return
            }
            // Joining a meeting, Settings stays closed (Devices shows the
            // camera's preview).
            const joining = Qt.application.arguments.indexOf("--join-test") >= 0
            if (step === 0) { if (!joining) { rail.current = "settings"; settingsView.pageForTest("devices") } }
            else if (step === 1) {
                if (Qt.application.arguments.indexOf("--spatial-audio-on") >= 0) settingsView.toggleSpatialForTest(true)
                if (Qt.application.arguments.indexOf("--spatial-audio-off") >= 0) settingsView.toggleSpatialForTest(false)
            }
            else if (step === 2) { settingsView.scrollToCardForTest("audio"); console.warn("SPATIAL row", JSON.stringify(settingsView.spatialRowForTest()), "setting", JSON.stringify(backend.setting("spatialAudio"))) }
            else if (step === 3) { if (!joining) settingsView.scrollToForTest(330) }
            else if (step === 4) { if (!joining) shot("spatial-devices") }
            else if (step === 5 && Qt.application.arguments.indexOf("--join-test") < 0) { Qt.quit(); return }
            step++
        }
    }

    // --tty-test: Settings ▸ Accessibility's Teletypewriter (TTY) mode
    // (TASK-0151): the card, turned on (--tty-test=on) or off (=off), the
    // notice Teams shows after a change; TTY lines, -tty-*.png.
    Timer {
        readonly property string arg: Qt.application.arguments.find(a => a.startsWith("--tty-test")) || ""
        running: arg !== "" && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + n + ".png"))) }
        onTriggered: {
            if (step === 0) { rail.current = "settings"; settingsView.pageForTest("accessibility") }
            else if (step === 1) { console.warn("TTY before", JSON.stringify(settingsView.ttyForTest()), "cards", JSON.stringify(settingsView.cardsForTest())); shot("tty-before") }
            else if (step === 2) { if (arg.endsWith("=on")) settingsView.toggleTtyForTest(true); else if (arg.endsWith("=off")) settingsView.toggleTtyForTest(false) }
            else if (step === 3) { console.warn("TTY after", JSON.stringify(settingsView.ttyForTest()), "cards", JSON.stringify(settingsView.cardsForTest())); shot("tty-after") }
            else { Qt.quit(); return }
            step++
        }
    }

    // --sign-language-test=<SIGNER|INTERPRETER|off>[,<interpreter MRI>…]
    // (TASK-0182): Settings ▸ Accessibility's Sign language mode set that
    // way (captured), then, with --join-test, SIGN lines every 4 s in the
    // meeting: your role, the roster's sign states, who comes first, the
    // featured tile in the Sign language view (picked at the third line),
    // People lines. `off` puts the mode back off with no interpreters.
    Timer {
        readonly property var arg: ((Qt.application.arguments.find(a => a.startsWith("--sign-language-test=")) || "").slice(21)).split(",").filter(s => s)
        running: arg.length > 0 && backend.signedIn
        interval: 4000; repeat: true
        property int step: 0
        property int inCall: 0
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-sl-" + n + ".png"))) }
        function callShot(n) { callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-sl-" + n + ".png"))) }
        onTriggered: {
            const role = arg[0]
            if (step === 0) {
                if (role === "off") settingsView.setPropForTest("callAccessibilitySettings", "", { accessibilityModeEnabledV2: false, signLanguageModeSelection: "SIGNER", selectedDHHInterpreters: [] })
                else settingsView.setPropForTest("callAccessibilitySettings", "", { accessibilityModeEnabledV2: true, signLanguageModeSelection: role, showSignerIdentificationToOthers: true, selectedDHHInterpreters: arg.slice(1) })
            } else if (step === 1) { rail.current = "settings"; settingsView.pageForTest("accessibility") }
            else if (step === 2) { console.warn("SIGN settings", JSON.stringify(syncedProps.callAccessibilitySettings), "cards", JSON.stringify(settingsView.cardsForTest())); shot("settings") }
            else if (step === 3 && arg.length > 1) { settingsView.pageForTest("accessibility", "interpreters"); backend.resolveNames(JSON.stringify(arg.slice(1))) }
            else if (step === 4 && arg.length > 1) { shot("interpreters"); settingsView.pageForTest("accessibility") }
            if (callWindow.live) {
                inCall++
                const w = callWindow
                // --sign-language-admit: let in whoever waits (the other
                // test account).
                const lobby = JSON.parse(backend.callLobbyJson || "[]")
                if (Qt.application.arguments.indexOf("--sign-language-admit") >= 0 && lobby.length) {
                    console.warn("SIGN admitting", JSON.stringify(lobby.map(p => p.name)))
                    lobby.forEach(p => backend.admitFromLobby(p.id, p.name, true))
                }
                console.warn("SIGN call", JSON.stringify({ mode: w.signMode, iSign: w.iSign, published: w.signPublished, layout: w.layout,
                    roster: w.others.map(p => [p.name, p.sign_role || "", p.sign_content || "", w.hasVideo(p)]),
                    first: w.signFirst.map(p => p.name), people: w.people.map(p => [p.name, p.signLine || "", !!p.signFirst]),
                    menu: w.signMode }))
                if (inCall === 3) { w.layout = "accessibility"; w.contentItem.Accessible.announce("Accessibility mode was set") }
                if (inCall === 5) callShot("call-" + w.layout)
            }
            step++
        }
    }

    // --voice-isolation-test (TASK-0181, TASK-0183): in a call (with
    // --join-test or a 1:1 call harness), VITEST lines every 5 s: the
    // noise suppression choice, the isolator's counters, the dominant
    // speaker. --vi-off-at=<s> switches to Background noise only that many
    // seconds after the call goes live (--vi-on-at=<s> back to Voice
    // isolation). --vi-announce presses Announce active speaker
    // (Ctrl+Alt+Shift+S, a real key event) in the call window at each line
    // (ANNOUNCE lines). --vi-admit lets in whoever waits in the lobby.
    Timer {
        running: Qt.application.arguments.indexOf("--voice-isolation-test") >= 0 && backend.signedIn
        interval: 5000; repeat: true
        property int live: 0
        property var keys: null
        property int pinnedAt: 0
        function num(n) { return parseInt((Qt.application.arguments.find(a => a.startsWith("--vi-" + n + "-at=")) || "=0").split("=")[1]) || 0 }
        onTriggered: {
            if (!callWindow.live) { if (live > 0) console.warn("VITEST call", backend.callState); return }
            live++
            const w = callWindow, secs = live * 5
            const lobby = JSON.parse(backend.callLobbyJson || "[]")
            if (Qt.application.arguments.indexOf("--vi-admit") >= 0 && lobby.length) {
                console.warn("VITEST admitting", JSON.stringify(lobby.map(p => p.name)))
                lobby.forEach(p => backend.admitFromLobby(p.id, p.name, true))
            }
            if (num("off") && secs === num("off")) { backend.setSetting("noiseSuppressionMode", "Auto"); backend.applyVoiceIsolation(); console.warn("VITEST switched Background noise only") }
            if (num("on") && secs === num("on")) { backend.setSetting("noiseSuppressionMode", "Pns"); backend.applyVoiceIsolation(); console.warn("VITEST switched Voice isolation") }
            // --vi-camera: the camera on once in the call (a Signer's
            // sign language detection needs it).
            if (Qt.application.arguments.indexOf("--vi-camera") >= 0 && live === 1 && backend.callCanVideo && !backend.callCameraOn) backend.toggleCamera()
            console.warn("VITEST", secs, JSON.stringify({ vi: backend.voiceIsolationJson, stats: backend.voiceIsolationStats(), speaker: w.speakerId, others: w.others.map(p => [p.name, p.id]),
                signing: w.signingIds, camera: backend.callCameraOn,
                badges: w.others.concat([w.selfEntry]).filter(p => w.isSigning(p.self ? w.selfId : p.id)).map(p => [p.name, w.tetheredOf(p).map(q => q.name), w.signingTooltip(w.tetheredOf(p))]),
                stage: w.stageForTest() }))
            // --vi-pin-all=<n>: once <n> others are in the call, Pin for me
            // on each of them (the pin area); 30 s later they are unpinned.
            const pinAll = parseInt((Qt.application.arguments.find(a => a.startsWith("--vi-pin-all=")) || "=0").split("=")[1]) || 0
            if (pinAll > 0) {
                if (!pinnedAt && w.others.length >= pinAll) { w.others.forEach(p => w.pinPerson(p.id)); pinnedAt = secs }
                else if (pinnedAt && secs === pinnedAt + 30) w.others.forEach(p => w.unpinPerson(p.id))
            }
            // --vi-audio-ui: the Audio settings pane (10 s), then the Mic
            // flyout (20 s), with their noise suppression choice.
            if (Qt.application.arguments.indexOf("--vi-audio-ui") >= 0) {
                // The pane's Spatial audio row (TASK-0232): logged at 10,
                // 15 and 20 s; with --vi-spatial-pane switched from the
                // pane at 15 s and back at 20 s.
                const pane = w.audioPaneForTest()
                if (secs === 10) { w.side = "audio"; console.warn("VITEST pane spatial row", JSON.stringify(pane.spatialRowForTest())) }
                else if (secs === 15) {
                    if (Qt.application.arguments.indexOf("--vi-spatial-pane") >= 0) { pane.setSpatial(!pane.spatialOn); console.warn("VITEST pane spatial toggled") }
                    console.warn("VITEST pane spatial row", JSON.stringify(pane.spatialRowForTest()))
                    callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-vi-pane-15.png")))
                }
                else if (secs === 20) {
                    if (Qt.application.arguments.indexOf("--vi-spatial-pane") >= 0) { pane.setSpatial(!pane.spatialOn); console.warn("VITEST pane spatial toggled") }
                    console.warn("VITEST pane spatial row", JSON.stringify(pane.spatialRowForTest()))
                    w.side = ""; w.openAudioOptionsForTest()
                }
                // The flyout's Spatial audio row (TASK-0231); with
                // --vi-spatial-toggle it is switched at 25 s and back at 40 s.
                if (secs >= 20 && secs <= 45) console.warn("VITEST spatial row", JSON.stringify(w.audioFlyoutSpatialForTest()))
                if (Qt.application.arguments.indexOf("--vi-spatial-toggle") >= 0 && (secs === 25 || secs === 40)) { w.openAudioOptionsForTest(); w.toggleFlyoutSpatialForTest(); console.warn("VITEST spatial toggled", JSON.stringify(w.audioFlyoutSpatialForTest())) }
            }
            if (Qt.application.arguments.indexOf("--vi-shots") >= 0) callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-vi-" + secs + ".png")))
            if (Qt.application.arguments.indexOf("--vi-announce") >= 0) {
                if (!keys) keys = Qt.createQmlObject('import QtTest; TestCase { when: false; name: "viannounce" }', w.contentItem)
                w.requestActivate()
                keys.keyClick(Qt.Key_S, Qt.ControlModifier | Qt.AltModifier | Qt.ShiftModifier)
            }
        }
    }


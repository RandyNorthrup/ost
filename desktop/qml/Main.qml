                return
            }
            if (disconnected && devices.length === 0) { window.contentItem.grabToImage(r => r.saveToFile("/tmp/act/bt-unpaired.png")); console.warn("BT-UNPAIRED"); disconnected = false }
            if (st * interval > minutes * 60000) Qt.quit()

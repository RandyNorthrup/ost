    // --channel-share-test=<ops> (TASK-0087), one op every 6 s on
    // --share-team=<team name> (default OST Test Team), each logged as a
    // CHSHARE line with the backend's answer: create:<type>:<name> (Private
    // or Shared, through Create a channel's own request), members:<channel
    // name>:<person mri> (Teams' addChannelMembers), invite:<channel name>:
    // <owner mri> (Share with a team), own:<channel name>:<team name> (Share
    // with a team you own), sharedwith:<channel name>, invites (your Pending
    // invites), accept:<invitation id>:<team name>, decline:<invitation
    // id>, delete:<channel name>. Quits when done unless --share-stay.
    Timer {
        readonly property var ops: (Qt.application.arguments.find(a => a.startsWith("--channel-share-test=")) || "").slice(21).split(",").filter(s => s.length)
        running: ops.length > 0 && backend.signedIn && !!backend.teamsJson
        interval: 6000; repeat: true
        property int idx: 0
        property string lastOp: ""
        readonly property string teamName: (Qt.application.arguments.find(a => a.startsWith("--share-team=")) || "--share-team=OST Test Team").slice(13)
        function team(n) { return (JSON.parse(backend.teamsJson || "[]")).find(t => t.name === (n || teamName)) }
        function channel(n) { const t = team(); return t ? (t.channels || []).find(c => c.name === n) : null }
        onTriggered: {
            if (idx >= ops.length) { if (Qt.application.arguments.indexOf("--share-stay") < 0) Qt.quit(); stop(); return }
            const op = ops[idx++]
            const p = op.split(":")
            // createteam:<name> (a private team from scratch, you its owner),
            // deleteteam:<name>.
            if (p[0] === "createteam") { backend.channelAction("create-team", "", "", JSON.stringify({ mode: "scratch", name: p.slice(1).join(":"), description: "", "public": false, firstChannel: "" })); console.warn("CHSHARE", op); return }
            if (p[0] === "deleteteam") { const d = team(p.slice(1).join(":")); if (d) backend.channelAction("team-delete", d.id, d.thread_id, ""); console.warn("CHSHARE", op, d ? d.id : "(no team)"); return }
            const t = team()
            if (!t) { console.warn("CHSHARE no team", teamName); return }
            const ch = p.length > 1 ? channel(p[1]) : null
            lastOp = p[0]
            if (p[0] === "create") {
                const general = (t.channels || []).find(c => c.general)
                backend.channelAction("create-channel", t.id, general ? general.id : "", JSON.stringify({ name: p.slice(2).join(":"), description: "", type: p[1], layout: "Conversational", recommend: false }))
            } else if (p[0] === "members" && ch) backend.channelAction("channel-add-members", t.id, t.thread_id, JSON.stringify({ channel: ch.id, users: [{ mri: p.slice(2).join(":"), owner: false }] }))
            else if (p[0] === "invite" && ch) backend.channelAction("share-team-owner", t.id, ch.id, JSON.stringify({ users: [p.slice(2).join(":")] }))
            else if (p[0] === "own" && ch) { const o = team(p[2]); backend.channelAction("share-own-team", t.id, ch.id, JSON.stringify({ team: o ? o.id : "", thread: o ? o.thread_id : "" })) }
            else if (p[0] === "sharedwith" && ch) backend.channelAction("shared-with", t.id, ch.id, "")
            // answer:<channel>:<invitation id>:<approve|deny|remove> (the host's side).
            else if (p[0] === "answer" && ch) backend.channelAction("channel-invitation", t.id, ch.id, JSON.stringify({ id: p[2], action: p[3] }))
            // manage:<channel>: Manage channel on it (members, invites), with pictures.
            else if (p[0] === "manage" && ch) { window.openManageChannel(ch.id); Qt.callLater(() => window.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-share-manage.png")))) }
            else if (p[0] === "shot") window.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-share-" + (p[1] || "x") + ".png")))
            else if (p[0] === "mtab") manageChannel.tab = p[1]
            else if (p[0] === "invites") backend.channelAction("invitations", "", "", "")
            else if (p[0] === "accept") { const o = team(p[2]); backend.channelAction("invitation-answer", "", "", JSON.stringify({ id: p[1], thread: o ? o.thread_id : "" })) }
            else if (p[0] === "decline") backend.channelAction("invitation-answer", "", "", JSON.stringify({ id: p[1] }))
            else if (p[0] === "delete" && ch) backend.channelAction("delete-channel", t.id, ch.id, "")
            else console.warn("CHSHARE skipped", op, ch ? "" : "(no channel)")
            console.warn("CHSHARE", op)
        }
    }
    Connections {
        target: backend
        enabled: Qt.application.arguments.some(a => a.startsWith("--channel-share-test="))
        function onChannelActionResultChanged() { console.warn("CHSHARE result", backend.channelActionResult.slice(0, 6000)) }
    }
    // --profile-org-test=<object id>: that person's profile card on
    // Organization (Teams' org chart from Loki, TASK-0133): PROFILEORG lines
    // with the chart (managers, focus, reports, works with), pictures
    // profile-org-1.png; then the first manager (or report) as the person in
    // focus (profile-org-2.png), Back, Home. Quits unless --profile-org-stay.
    Timer {
        readonly property string who: (Qt.application.arguments.find(a => a.startsWith("--profile-org-test=")) || "").slice(19)
        running: who.length > 0 && backend.signedIn
        interval: 5000; repeat: true
        property int step: 0
        function shot(n) { window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-profile-org-" + n + ".png"))) }
        function log(tag) {
            const o = profileCard.card.org
            console.warn("PROFILEORG", tag, profileCard.card.displayName, o ? JSON.stringify({ managers: (o.managers || []).map(m => m.name), focus: o.focus.name + " " + o.focus.reports + "/" + o.focus.directs,
                directs: (o.directs || []).map(m => m.name + (m.jobTitle ? " (" + m.jobTitle + ")" : "")), worksWith: (o.worksWith || []).map(m => m.name) }) : "no org " + (profileCard.card.error || ""))
        }
        onTriggered: {
            if (step === 0) profileCard.show(who)
            else if (step === 2) { profileCard.tab = "organization" }
            else if (step === 3) { log("first"); shot(1) }
            else if (step === 4) { const o = profileCard.card.org; const next = o ? ((o.managers || [])[0] || (o.directs || [])[0]) : null; if (next) profileCard.visit(next.mri) }
            else if (step === 6) { log("visited"); shot(2); console.warn("PROFILEORG nav", profileCard.historyAt, profileCard.history.length) }
            else if (step === 7) { profileCard.stepTo(profileCard.historyAt - 1) }
            else if (step === 9) { log("back") }
            else if (step === 10) { if (Qt.application.arguments.indexOf("--profile-org-stay") < 0) Qt.quit() }
            step++
        }
    }
    // --app-bar-test[=<ops>]: the app bar and View more apps from your apps
    // (TASK-0238). Ops, comma separated, one every 4 s (each logged as an
    // APPBAR line with the bar's apps and their orders afterwards):
    // menus (every bar tile's and flyout row's menu), shot:<app> (that
    // tile's menu open, app-bar-<app>.png), flyout (View more apps open,
    // app-bar-flyout.png), pin:<app> / unpin:<app> / up:<app> / down:<app>
    // / uninstall:<app> (picked from the app's menu, Uninstall confirmed),
    // move:<app>:<order> (Teams' reorder to that order), storeunpin /
    // storepin, customize (Activity ▸ Customize app bar, app-bar-
    // customize.png), block:<app> / unblock:<app> (Block / Unblock bot
    // conversation), botchat:<app> (the bot's 1:1 chat and its state). <app> is the app's name as the bar or the flyout
    // shows it. Quits unless --app-bar-stay.
    Timer {
        id: pickerShot
        property var target: null
        property string key: ""
        interval: 2000
        onTriggered: if (target) {
            const p = target.tabPickerForTest()
            console.warn("APPBAR wplus picker", JSON.stringify({ opened: p.opened, apps: (p.store && p.store.installed ? p.store.installed.length : -1), pos: [p.x, p.y, p.width, p.height] }))
            target.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-app-window-" + key + "-picker.png")))
        }
    }
    Timer {
        readonly property var ops: Qt.application.arguments.some(a => a.startsWith("--app-bar-test"))
            ? ((Qt.application.arguments.find(a => a.startsWith("--app-bar-test=")) || "").slice(15) || "menus").split(",") : []
        running: ops.length > 0 && backend.signedIn && rail.barApps.length > 0
        interval: 4000; repeat: true
        property int idx: -1
        function tile(name) {
            for (let i = 0; i < rail.repeaterForTest().count; i++) { const it = rail.repeaterForTest().itemAt(i); if (it && it.modelData.label === name) return it }
            return null
        }
        function state() {
            return rail.barEntries.map(e => e.label + (e.app ? "=" + e.app.order : "")).join(" ") + " | store " + (rail.storeUnpinned ? "unpinned" : "pinned")
                + " | flyout " + rail.flyoutEntries.map(e => e.label).join(", ")
        }
        onTriggered: {
            if (idx < 0) { console.warn("APPBAR start", state()); idx = 0; return }
            if (idx >= ops.length) { if (Qt.application.arguments.indexOf("--app-bar-stay") < 0) Qt.quit(); stop(); return }
            const op = ops[idx++]
            const [verb, name, arg] = op.split(":")
            rail.closeMenusForTest()
            const flyKey = n => { const e = rail.flyoutEntries.find(f => f.label === n); return e ? e.key : "" }
            const pickIn = (n, label) => { const t = tile(n); if (t) return t.menuForTest() && t.pickForTest(label); const k = flyKey(n); return k ? rail.flyoutPickForTest(k, label) : false }
            let r = ""
            if (verb === "menus") {
                const out = {}
                for (const e of rail.apps) { const t = tile(e.label); if (t) { out["bar " + e.label] = t.menuForTest().join(" ; ") } }
                for (const e of rail.flyoutEntries) out["flyout " + e.label] = rail.flyoutMenuForTest(e.key).join(" ; ")
                if (rail.storeUnpinned) out["flyout Store"] = rail.flyoutMenuForTest("add").join(" ; ")
                for (const k in out) console.warn("APPBAR menu", k, "::", out[k])
                r = "listed"
            } else if (verb === "shot") {
                const t = tile(name); if (t) { r = t.menuForTest().join(" ; "); Qt.callLater(() => window.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-app-bar-" + name.replace(/\W/g, "") + ".png")))) }
            } else if (verb === "flyout") {
                rail.openFlyout(); Qt.callLater(() => window.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-app-bar-flyout.png")))); r = "open"
            } else if (verb === "pin") r = pickIn(name, qsTr("Pin"))
            else if (verb === "unpin") r = pickIn(name, qsTr("Unpin"))
            else if (verb === "up") r = pickIn(name, qsTr("Move up"))
            else if (verb === "down") r = pickIn(name, qsTr("Move down"))
            else if (verb === "window") r = pickIn(name, qsTr("Open in new window"))
            else if (verb === "wshot") {
                // wshot:<key>[:<chat id to show>]: that app's window, pictured.
                const w = window.appWindows[name]
                if (w) {
                    if (arg && w.showChat) {
                        const cid = op.slice(op.indexOf(arg))
                        let ch = chatList.chats.find(c => c.id === cid)
                        for (const t of (backend.teamsJson ? JSON.parse(backend.teamsJson) : [])) if (!ch) ch = (t.channels || []).find(c => c.id === cid)
                        w.showChat(cid, ch ? ch.name : "")
                    }
                    r = JSON.stringify({ title: w.title, size: [w.width, w.height], chat: w.chatId || "" })
                    w.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-app-window-" + name + ".png")))
                }
            } else if (verb === "core") { r = !!window.popOutCore(name)   // core:<key>: that app's window directly
            } else if (verb === "wtab") { const w = window.appWindows[name]; if (w) { const c = w.conversationForTest(); r = JSON.stringify({ tabs: c.tabNames, shown: c.windowTabs }) }
            } else if (verb === "wplus") {
                // wplus:<key>: the window's chat's "+" (Add a tab); its picker
                // in that window (app-window-<key>-picker.png 2 s later), or
                // wplus:<key>:close to close it.
                const w = window.appWindows[name]
                if (w && arg === "close") { w.tabPickerForTest().close(); r = "closed" }
                else if (w) {
                    w.conversationForTest().addTab()
                    const p = w.tabPickerForTest()
                    r = JSON.stringify({ inWindow: p.opened, mainPicker: tabPicker.opened, size: [p.width, p.height], window: [w.width, w.height] })
                    pickerShot.target = w; pickerShot.key = name; pickerShot.restart()
                }
            } else if (verb === "wevents") {
                // wevents:events: the Events window's state (Discover's lists),
                // and the main window's Events for comparison.
                const w = window.appWindows[name]; const ev = w && w.eventsForTest ? w.eventsForTest() : null
                r = JSON.stringify({ window: ev ? JSON.parse(ev.stateForTest()) : null, past: ev && ev.discoverData ? (ev.discoverData.past || []).map(c => c.title) : null })
            } else if (verb === "wclose") { const w = window.appWindows[name]; if (w) { w.close(); r = true } }
            else if (verb === "block") r = pickIn(name, qsTr("Block bot conversation"))
            else if (verb === "unblock") r = pickIn(name, qsTr("Unblock bot conversation"))
            else if (verb === "botchat") { const a = rail.barApps.find(x => x.name === name); const c = rail.botChat(a); r = JSON.stringify({ bot: a ? a.bot_id : "", chat: c ? c.id : "", blocked: c ? !!c.messagingDisabled : null }) }
            else if (verb === "storeunpin") r = pickIn(qsTr("Store"), qsTr("Unpin"))
            else if (verb === "storepin") r = rail.flyoutPickForTest("add", qsTr("Pin"))
            else if (verb === "uninstall") { r = pickIn(name, qsTr("Uninstall")); if (r) Qt.callLater(() => { console.warn("APPBAR dialog", appUninstall.title, "/", appUninstall.body); appUninstall.close(); appUninstall.confirmed() }) }
            else if (verb === "move") {
                const a = rail.barApp((rail.barEntries.find(e => e.label === name) || {}).key || "") || rail.barApps.find(x => x.name === name)
                if (a) { rail.barChangeRequested(a.id, "move", parseInt(arg)); r = true }
            } else if (verb === "moveid" || verb === "unpinid" || verb === "pinid") {
                // By app id (an app the bar doesn't show by name).
                rail.barChangeRequested(name, verb === "moveid" ? "move" : verb === "unpinid" ? "unpin" : "pin", parseInt(arg || "0")); r = true
            } else if (verb === "customize") {
                r = pickIn(rail.barEntries[0].label, qsTr("Customize app bar"))
                Qt.callLater(() => window.contentItem.grabToImage(g => g.saveToFile(window.shotPath.replace(".png", "-app-bar-customize.png"))))
            }
            console.warn("APPBAR", op, "->", r)
            Qt.callLater(() => console.warn("APPBAR after", op, state()))
        }
    }
    // --app-window-test=<key>: that hosted app (planner, onenote,
    // whiteboard, shifts, clipchamp) from the app bar, then its window of
    // its own (Open in new window); after 30 s APPWINDOW lines: the window's
    // size and title, the page's host events, header and context, and the
    // rail menu's items; app-window.png (the window). Quits unless
    // --app-window-stay.
    Timer {
        readonly property string key: (Qt.application.arguments.find(a => a.startsWith("--app-window-test=")) || "").slice(18)
        running: key.length > 0 && backend.signedIn && chatList.chats.length > 1
        interval: 3000; repeat: true
        property int step: 0
        property var w: null
        onTriggered: {
            if (step === 0) rail.openApp(key)
            else if (step === 3) w = window.popOutApp(key)
            else if (step === 13 && w) {
                const v = w.pageForTest()
                console.warn("APPWINDOW", JSON.stringify({ title: w.title, size: [w.width, w.height], events: v.hostEvents, header: v.headerShown, tab: v.personalTab ? v.personalTab.entity_id : "" }))
                w.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-app-window.png")))
            }
            else if (step === 15) { if (Qt.application.arguments.indexOf("--app-window-stay") < 0) Qt.quit() }
            step++
        }
    }
    // --embedded-apps-test[=<list>]: Teams' embedded first-party apps as OST
    // hosts them (TASK-0038, docs/spec/app-host.md), one after another, about
    // 40 s each: whiteboard, shifts, clipchamp (the app bar's personal apps),
    // copilot (the chat list's row), office (ost-open-test.docx from My
    // files with the "Teams" choice, the device setting put back after),
    // settings (Files and links), sto (Share to Outlook on your newest
    // message in --embed-chat, default OST group test; closed without
    // sending, which discards the draft) and ir (Immersive Reader on the
    // newest message). EMBED lines: each app's host events (TeamsJS
    // initialize, appLoaded, success, failure…) or the dialog's state;
    // pictures embed-<item>.png. Quits unless --embed-stay.
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--embedded-apps-test")) && backend.signedIn && chatList.chats.length > 1
        interval: 5000; repeat: true
        property var items: ((Qt.application.arguments.find(a => a.startsWith("--embedded-apps-test=")) || "").slice(21) || "whiteboard,shifts,clipchamp,copilot,settings,office,sto,ir").split(",")
        property int idx: 0
        property int tick: 0
        property string before: ""
        readonly property string chatId: (Qt.application.arguments.find(a => a.startsWith("--embed-chat=")) || "").slice(13) || "19:ef213c7c46cf4036b11608300e96fee4@thread.v2"
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-embed-" + tag + ".png")))
            const item = items[idx]
            const next = () => { idx++; tick = -1; if (idx >= items.length && Qt.application.arguments.indexOf("--embed-stay") < 0) Qt.quit() }
            if (idx >= items.length) return
            const hosted = ["whiteboard", "planner", "onenote", "clipchamp", "shifts"].indexOf(item)
            // --embed-message=<text>: the newest message with that text (a
            // card's message for the reader's card text), else your newest.
            const want = (Qt.application.arguments.find(a => a.startsWith("--embed-message=")) || "").slice(16)
            const newest = () => { const ms = conversation.messageHostForTest().messages || []; for (let i = ms.length - 1; i >= 0; i--) if (ms[i].id && !ms[i].deleted && (want ? (ms[i].text || "").indexOf(want) >= 0 : ms[i].mine)) return ms[i]; return null }
            if (hosted >= 0) {
                if (tick === 0) rail.openApp(item)
                else if (tick === 8) {
                    const v = window.hostedAppView(item)
                    console.warn("EMBED", item, JSON.stringify({ events: v ? v.hostEvents : null, header: v ? v.headerShown : null, tab: v && v.personalTab ? v.personalTab.entity_id : "" }))
                    cap(item); next()
                }
            } else if (item === "copilot") {
                if (tick === 0) { rail.current = "chat"; chatList.openCopilot() }
                else if (tick === 9) { const v = copilotView.item; console.warn("EMBED copilot", JSON.stringify({ events: v ? v.hostEvents : null })); cap(item); next() }
            } else if (item === "settings") {
                if (tick === 0) { rail.current = "settings"; settingsView.pageForTest("files") }
                else if (tick === 1) { cap(item); next() }
            } else if (item === "office") {
                const f = (oneDrive.driveData.items || []).find(i => i.name === "ost-open-test.docx")
                if (tick === 0) { before = backend.setting("fileOpenIn"); backend.setSetting("fileOpenIn", "teams"); rail.current = "onedrive"; oneDrive.open("myfiles") }
                else if (tick === 2) { console.warn("EMBED office file", !!f); if (f) backend.openFile(f.web_url, f.name, JSON.stringify(f)) }
                else if (tick === 10) {
                    const v = officeView.item
                    console.warn("EMBED office", JSON.stringify({ rail: rail.current, app: window.officeFile ? window.officeFile.appName : "", events: v ? v.hostEvents : null, frame: v ? JSON.parse(v.hostStateForTest()).params : null }))
                    cap(item); backend.setSetting("fileOpenIn", before); next()
                }
            } else if (item === "sto" || item === "ir") {
                if (tick === 0) { rail.current = "chat"; chatList.copilotOpen = false; const c = chatList.chats.find(c => c.id === chatId); if (c) backend.selectChat(c.id, c.name) }
                else if (tick === 3) {
                    const m = newest(); const h = conversation.messageHostForTest()
                    console.warn("EMBED", item, "message", !!m, m && item === "ir" ? JSON.stringify({ cards: (m.cards || []).length, reader: (m.reader_html || "").slice(0, 400) }) : "")
                    if (m && item === "sto") h.shareToOutlookForTest.start(m)
                    else if (m) h.openImmersiveReader(m)
                } else if (tick === 9) {
                    const h = conversation.messageHostForTest()
                    if (item === "sto") {
                        const d = h.shareToOutlookForTest.dialog
                        console.warn("EMBED sto", JSON.stringify({ events: h.shareToOutlookForTest.events, dialog: d ? JSON.parse(d.stateForTest()).events : null }))
                    } else console.warn("EMBED ir", h.immersiveReaderForTest.stateForTest())
                    cap(item)
                } else if (tick === 10) {
                    const h = conversation.messageHostForTest()
                    if (item === "sto") h.shareToOutlookForTest.close(); else h.immersiveReaderForTest.close()
                } else if (tick === 12) {
                    const h = conversation.messageHostForTest()
                    console.warn("EMBED", item, "closed", item === "sto" ? JSON.stringify(h.shareToOutlookForTest.events) : h.immersiveReaderForTest.opened)
                    next()
                }
            } else next()
            tick++
        }
    }

    // --events-test[=create]: the Events app (docs/spec/events.md) from
    // View more apps: Discover, Manage, Create event and the New event
    // form, logging EVENTS lines (each page's state) and capturing
    // events-{discover,manage,create,form}.png. With =create it also saves
    // a draft named "OST TEST 209 draft <time>" (nobody invited, so nobody
    // is told), shows its page (events-draft.png), cancels it (the draft
    // is deleted) and reloads Manage. Quits unless --events-stay.
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--events-test") && !/^--events-test=(full|invite|myevents|uninvite|calclean|emails|branding|collections)$/.test(a)) && backend.signedIn
        interval: 3000; repeat: true
        property int step: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-events-" + tag + ".png")))
            const ev = eventsView.item
            const log = tag => console.warn("EVENTS", tag, ev ? ev.stateForTest() : "no view")
            // =townhall: the same with Teams' Town hall template (TASK-0184),
            // the draft named "OST TEST 184 town hall draft <time>".
            const townHall = Qt.application.arguments.indexOf("--events-test=townhall") >= 0
            const live = Qt.application.arguments.indexOf("--events-test=create") >= 0 || townHall
            // =register:<title> (TASK-0217): Discover's card of that title
            // ("~" for spaces), Register's dialog, the terms ticked,
            // Register, "You're registered!", Discover reloaded with the
            // card Registered; then (--events-unregister) Unregister and
            // Discover again. EVENTS register lines; -events-reg-*.png.
            const regArg = Qt.application.arguments.find(a => a.startsWith("--events-test=register:"))
            if (regArg) {
                const title = regArg.slice(23).replace(/~/g, " ")
                const rlog = t => console.warn("EVENTS register", t, ev ? JSON.stringify(ev.registerStateForTest(title)) : "no view")
                // --events-answers=<json> (TASK-0227): the form's answers by
                // question index; Register is pressed empty first (Teams'
                // checks, -events-reg-errors.png), then with them.
                const ansArg = Qt.application.arguments.find(a => a.startsWith("--events-answers="))
                const answers = ansArg ? JSON.parse(ansArg.slice(17)) : null
                const flog = t => console.warn("EVENTS register form", t, ev ? JSON.stringify(ev.registerFormForTest()) : "no view")
                switch (step) {
                case 0: rail.openApp("events"); break
                case 3: rlog("discover"); cap("reg-discover"); break
                case 4: rlog("open " + ev.registerOpenForTest(title)); break
                case 6: rlog("dialog"); flog("shown"); cap("reg-dialog"); break
                case 7:
                    if (answers) { ev.registerAnswerForTest({}); flog("empty submit"); cap("reg-errors"); break }
                    ev.registerSubmitForTest(); rlog("submitted"); break
                case 8: if (answers) { ev.registerAnswerForTest(answers); flog("answered"); cap("reg-answered") } break
                case 9: rlog("done"); flog("done"); cap("reg-done"); break
                case 10: ev.registerCloseForTest(); ev.reload(); break
                case 13: rlog("reloaded"); cap("reg-card"); break
                case 14: if (Qt.application.arguments.indexOf("--events-unregister") < 0) { Qt.quit(); step = 1000; return } rlog("unregister " + ev.unregisterForTest(title)); break
                case 15: cap("reg-unregister"); ev.unregisterConfirmForTest(); break
                case 17: ev.reload(); break
                case 20: rlog("unregistered"); cap("reg-card-after"); Qt.quit(); step = 1000; return
                }
                step++
                return
            }
            switch (step) {
            case 0: rail.openApp("events"); break
            case 3: log("discover"); cap("discover"); break
            case 4: ev.openTab("manage"); break
            case 6: log("manage"); cap("manage"); break
            case 7: ev.startCreate(); break
            case 8: log("create"); cap("create"); break
            case 9: ev.startForm(ev.templates[townHall ? 2 : 0]); break
            case 10: if (townHall) ev.openOptionsForTest(); cap("form"); break
            case 11: if (!live) { log("done"); if (Qt.application.arguments.indexOf("--events-stay") < 0) Qt.quit(); step = 1000; return } ev.saveForTest((townHall ? "OST TEST 184 town hall draft " : "OST TEST 209 draft ") + Qt.formatTime(new Date(), "hh:mm")); break
            case 12: cap("save"); ev.confirmSaveForTest(); break
            case 16: log("saved"); cap("draft"); break
            case 17: ev.cancelCurrentForTest(); break
            case 19: log("cancelled"); ev.openTab("manage"); backend.loadCalendar(new Date(Date.now() - 7 * 86400000).toISOString().slice(0, 19) + "Z", new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 19) + "Z"); break
            case 22: log("manage after"); cap("manage-after"); break
            // Test cleanup: a cancelled event stays in your calendar as
            // "Canceled: <title>" (as in Teams); the test's are removed.
            case 23: for (const c of (backend.calendarJson ? JSON.parse(backend.calendarJson) : []).filter(c => /^Canceled: OST TEST (209|184 town hall draft)/.test(c.subject))) { console.warn("EVENTS removing", c.subject); backend.deleteEvent(c.id) } break
            case 25: if (Qt.application.arguments.indexOf("--events-stay") < 0) Qt.quit(); break
            }
            step++
        }
    }

    // --events-test=full (TASK-0212): Events' remaining pages, actions and
    // pickers, end to end with the signed-in account (run as OST Test 3):
    // Discover's My events and Custom range, Manage's See more and Connect
    // apps, Create's saved templates, the form's time zone, co-organizer /
    // presenter / room pickers, description formatting, stage preview and
    // All options; a draft "OST TEST 212 OST draft <hh:mm>" (OST Test 2
    // co-organizer, OST Test 1 presenter, OST Test Room), its tabs and
    // Preview, Save as template, Duplicate ("OST TEST 212 OST copy"), Edit
    // details, Publish of the copy and its Share dialog, Copy join details,
    // Pin app (Teams' pinned apps) and back; then everything made is
    // cancelled or deleted. EVENTS lines and events-full-*.png.
    Timer {
        running: Qt.application.arguments.indexOf("--events-test=full") >= 0 && backend.signedIn
        interval: 3000; repeat: true
        property int step: 0
        property var draft: null
        property var copy: null
        property int waited: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-events-full-" + tag + ".png")))
            const ev = eventsView.item
            const log = (tag, extra) => console.warn("EVENTS", tag, ev ? ev.stateForTest() : "no view", extra !== undefined ? JSON.stringify(extra) : "")
            const stamp = Qt.formatTime(new Date(), "hh:mm")
            const today = new Date(); today.setHours(0, 0, 0, 0)
            switch (step) {
            case 0: rail.openApp("events"); break
            case 3: log("discover"); cap("discover"); break
            case 4: ev.filtersForTest(true, "", null, null); break
            case 6: log("my events"); cap("mine"); break
            case 7: ev.filtersForTest(false, "custom", today, new Date(today.getTime() + 12 * 86400000)); break
            case 9: log("custom range"); cap("range"); break
            case 10: ev.clearFilters(); ev.openTab("manage"); break
            case 12: log("manage"); cap("manage"); break
            case 13: ev.openSeeMore("Published", "Published"); break
            case 15: log("see more"); cap("seemore"); break
            case 16: ev.connectAppsForTest(); break
            case 17: log("connect apps", ev.connectAppsStateForTest()); cap("connect"); break
            case 18: ev.closeConnectAppsForTest(); ev.startCreate(); break
            case 20: log("create"); cap("create"); ev.startForm(ev.templates[0]); ev.zoneForTest(true); break
            case 21: ev.pickerForTest("team").typeForTest("OST Test 2"); break
            case 23: ev.pickerForTest("team").pickFirstForTest(); ev.pickerForTest("presenters").typeForTest("OST Test 1"); break
            case 25: ev.pickerForTest("presenters").pickFirstForTest(); ev.pickerForTest("rooms").typeForTest("OST"); break
            case 27: cap("rooms"); break
            case 28: ev.pickerForTest("rooms").pickFirstForTest(); ev.descriptionForTest("OST TEST 212 OST description bold"); ev.scrollFormForTest(330); break
            case 29: log("form"); cap("form"); break
            case 30: ev.openSectionsForTest([false, true, true, false]); break
            case 31: cap("form-people"); break
            case 32: ev.openOptionsForTest(); ev.scrollFormForTest(600); break
            case 33: log("form options", ev.stageShotForTest(window.shotPath.replace(".png", "-events-full-stage.png"))); cap("form-options"); break
            case 34: ev.allOptionsForTest(); break
            case 35: log("all options", ev.allOptionsStateForTest()); cap("alloptions"); break
            case 36: ev.closeAllOptionsForTest(); ev.saveForTest("OST TEST 212 OST draft " + stamp); break
            case 37: cap("save"); break
            case 38: ev.confirmSaveForTest(); break
            case 40: if (!ev.current && waited++ < 20) return; waited = 0; draft = ev.current; log("saved"); cap("overview"); break
            case 41: ev.eventTab = "people"; ev.loadPeopleTab(); break
            case 43: log("people"); cap("people"); break
            case 44: ev.eventTab = "insights"; break
            case 45: cap("insights"); ev.eventTab = "highlights"; break
            case 46: cap("highlights"); ev.eventTab = "overview"; ev.previewOn = true; break
            case 47: cap("preview"); break
            case 48: ev.previewOn = false; ev.templateForTest("OST TEST 212 OST template"); break
            case 49: cap("template-dialog"); ev.saveTemplateForTest(); break
            case 52: ev.startCreate(); break
            case 54: ev.scrollCreateForTest(); break
            case 55: log("templates"); cap("templates"); ev.duplicateEvent(draft); break
            case 57: log("duplicate form"); ev.saveForTest("OST TEST 212 OST copy " + stamp); break
            case 58: ev.confirmSaveForTest(); break
            // Teams' duplicate takes a while: wait for the copy's page.
            case 61: if (!ev.current || !/^OST TEST 212 OST copy/.test(ev.current.title || "")) { if (waited++ < 20) return } waited = 0; break
            case 62: copy = ev.current; log("copy saved"); ev.editEvent(copy); break
            case 64: log("edit form"); cap("edit"); break
            case 65: ev.descriptionForTest("OST TEST 212 OST edited text"); ev.saveChangesForTest(); break
            case 68: log("edited"); cap("edited"); break
            case 69: ev.publishCurrentForTest(); break
            case 71: ev.openEvent(copy); break
            case 73: log("published"); ev.shareForTest(true); break
            case 74: cap("share"); ev.copyJoinDetails(ev.current); break
            case 75: ev.closeShareForTest(); ev.setPinned(true); break
            case 77: log("pinned", rail.pinned); backend.eventsRequest("pinned", "railcheck", "{}"); break

    // --collab-test: Settings ▸ Chats and channels' "Viewing chats, teams,
    // and channels", then Separate: Chat's list, the Teams app's, a channel
    // opened from it; back to Combined. Logs COLLAB lines.
    Timer {
        running: Qt.application.arguments.indexOf("--collab-test") >= 0 && backend.signedIn && chatList.chats.length > 2
        interval: 2500; repeat: true
        property int step: 0
        onTriggered: {
            const log = (...a) => console.warn("COLLAB", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const set = unified => backend.changeSetting("prop", "simpleCollabUserSettings", JSON.stringify({ hasUserEnabledAdaptiveRailForDesktop: true, hasUserEnabledUnifiedAppForDesktop: unified }))
            switch (step) {
            case 0: rail.current = "settings"; settingsView.pageForTest("chats"); break
            case 1: cap("settings"); set(false); break
            case 3: log("split", window.splitView); window.openCollab("chats"); break
            case 4: log("chat pane", chatList.pane, chatList.pillDefs.map(p => p.label), chatList.sections.map(s => s.folder.kind)); cap("chats"); break
            case 5: window.openCollab("teams"); break
            case 6: log("teams pane", chatList.pane, chatList.pillDefs.map(p => p.label), chatList.sections.map(s => s.folder.kind)); cap("teams"); break
            case 7: { const t = (backend.teamsJson ? JSON.parse(backend.teamsJson) : []).find(t => (t.channels || []).length); const ch = t.channels[0]; window.openCollab("chats"); backend.selectChat(ch.id, ch.name); break }
            case 9: log("after channel", window.collabPane); cap("channel"); break
            case 10: set(true); break
            case 12: log("restored split", window.splitView, chatList.pane); Qt.quit(); return
            }
            step++
        }
    }

    // --appearance-test: Settings ▸ Appearance (Theme with "Always use dark
    // theme for calls and meetings", App bar), then app names in the rail,
    // auto collapse after picking an app, and a dark pre-join (Meet now,
    // never joined) in the Light theme. Settings are put back. Logs
    // APPEARANCE lines.
    Timer {
        running: Qt.application.arguments.indexOf("--appearance-test") >= 0 && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property var before: null
        onTriggered: {
            const log = (...a) => console.warn("APPEARANCE", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const cap = (tag, w) => (w || window).contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            switch (step) {
            case 0: before = [window.appBarNames, window.appBarAutoCollapse, window.darkCallSetting]; rail.current = "settings"; settingsView.pageForTest("appearance"); break
            case 2: cap("settings"); break
            case 3: window.appBarNames = true; rail.current = "chat"; break
            case 4: cap("names"); window.appBarAutoCollapse = true; break
            case 5: rail.pick("calendar"); break
            case 6: log("collapsed after pick", rail.collapsed); cap("collapsed"); rail.collapsed = false; rail.current = "chat"; window.appBarAutoCollapse = false; window.appBarNames = false; break
            case 7: window.darkCallSetting = true; log("light", !theme.dark, "callsDark", window.callsDark); preJoin.openMeetNow("", "OST appearance test"); break
            case 10: cap("prejoin-dark", preJoin); break
            case 11: preJoin.cancel(); window.appBarNames = before[0]; window.appBarAutoCollapse = before[1]; window.darkCallSetting = before[2]; before.push(backend.themeMode); backend.setSetting("theme", "classic"); break
            case 13: log("classic", theme.classic, String(theme.titleBar)); cap("classic"); break
            case 14: backend.setSetting("theme", before[3]); log("restored", before); break
            case 15: Qt.quit(); return
            }
            step++
        }
    }

    // --editor-test: Teams' Editor in the compose box of "OST group test"
    // (never sent): misspellings squiggled, the card on the first, its first
    // suggestion applied, Ignore all on another; the box is cleared. Logs
    // EDITOR lines.
    Timer {
        running: Qt.application.arguments.indexOf("--editor-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        property string before: ""
        onTriggered: {
            const log = (...a) => console.warn("EDITOR", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const c = conversation.composeForTest()
            const words = () => c.critiques.map(x => x.word + "@" + x.start + "→" + x.suggestions.slice(0, 3).join("/"))
            switch (step) {
            case 0: { const g = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(g.id, g.name); break }
            case 2: c.setPlain("Thsi is a tset of teh speling"); break
            case 6: log("critiques", words()); cap("squiggles"); break
            case 7: c.critiqueCardForTest(0); break
            case 8: cap("card"); break
            case 9: { const cr = c.critiques[0]; c.closeCardForTest(); c.applySuggestion(cr, cr.suggestions[0]); break }
            case 12: log("fixed", c.plainText(), words()); cap("fixed"); break
            case 13: { const t = c.critiques.find(x => x.word === "teh"); if (t) backend.editorIgnoreWord(t.word); break }
            case 14: log("ignored teh", words()); break
            case 15: c.setPlain(""); break
            case 16: log("cleared", JSON.stringify(c.plainText())); before = backend.setting("editorCritiques"); showEditorSettings(true); break
            case 18: cap("manage-empty"); backend.editorSetLanguages('["en-us"]'); break
            case 21: log("settings", JSON.parse(backend.editorSettingsJson()).languages); cap("manage"); break
            case 22: showEditorSettings(false); break
            case 25: log("options", backend.editorCategoriesJson("en-us").slice(0, 200)); cap("options"); break
            case 26: backend.setSetting("editorCritiques", JSON.stringify({ "en-us": { "d1cf9ade-e82a-45aa-98b8-9ee16a0dc132": "0", "19a112ec-21fd-432a-9d1f-195e5e94a00b": "1" } })); break
            case 27: cap("options-changed"); break
            case 28: backend.setSetting("editorCritiques", before); backend.editorSetLanguages("[]"); break
            case 31: log("restored", JSON.parse(backend.editorSettingsJson()).languages, backend.setting("editorCritiques")); Qt.quit(); return
            }
            step++
        }
    }

    // --regional-test: Settings ▸ General's Language and regional formats:
    // Follow OS on, then off with English (United Kingdom), yyyy-MM-dd and
    // 01:01 - 23:59 chosen, then Save and restart; after the restart the
    // formats are in effect (chat list and a chat captured), then your
    // settings are put back. Logs REGIONAL lines.
    // --regional-chats=<name>|<name>…: after the restart also open each of
    // these chats, capture it and log its event rows (system messages, calls)
    // and the chat list's names and previews.
    Timer {
        running: Qt.application.arguments.indexOf("--regional-test") >= 0 && backend.signedIn && chatList.chats.some(c => /^OST TEST/.test(c.name) || c.name === "OST Test 2")
        interval: 2500; repeat: true
        property int step: 0
        readonly property bool restarted: backend.setting("regionalTest") !== ""
        // --regional-lang=<code>: the app language to pick (default en-gb).
        readonly property string lang: (Qt.application.arguments.find(a => a.startsWith("--regional-lang=")) || "--regional-lang=en-gb").slice(16)
        readonly property var chats: (Qt.application.arguments.find(a => a.startsWith("--regional-chats=")) || "--regional-chats=").slice(17).split("|").filter(s => s.length > 0)
        property int cstep: 0
        onTriggered: {
            const log = (...a) => console.warn("REGIONAL", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const keys = ["regionalFollowOs", "appLanguage", "regionalDateFormat", "regionalTimeFormat"]
            const card = () => settingsView.regionalForTest()
            if (!restarted) {
                switch (step) {
                case 0: log("in effect", theme.regional); rail.current = "settings"; settingsView.pageForTest("general"); break
                case 2: settingsView.scrollToRegionalForTest(); break
                case 3: cap("follow"); break
                case 4: card().followOs = false; break
                case 5: cap("off"); break
                case 6: card().appLanguage = lang; card().dateFormat = "yyyy-MM-dd"; card().timeFormat = "hh:mm tt"; break
                case 7: log("chosen", card().appLanguage, card().dateFormat, card().timeFormat, "changed", card().changed); cap("chosen"); break
                case 8: backend.setSetting("regionalTest", JSON.stringify(keys.map(k => backend.setting(k)))); card().followOs = false; backend.saveRegionalAndRestart(false, lang, "yyyy-MM-dd", "hh:mm tt"); return
                }
            } else {
                if (step === 1 && cstep < 3 * chats.length) {
                    const i = Math.floor(cstep / 3), c = chatList.chats.find(x => x.name === chats[i])
                    if (cstep % 3 === 0 && c) backend.selectChat(c.id, c.name)
                    if (cstep % 3 === 2) {
                        cap("after-chat-" + i)
                        log("rows", chats[i], c ? JSON.parse(backend.messagesJson || "[]").filter(m => m.event || m.call_state).map(m => m.event ? m.text : m.call_state + " " + m.call_seconds + "s") : "no such chat")
                    }
                    cstep++
                    return
                }
                switch (step) {
                case 0: log("after restart", theme.regional, "now", theme.dateTime(new Date()), theme.dateMaybeYear(new Date(2025, 2, 4)), theme.time(new Date(2026, 0, 31, 16, 9))); log("chat list", chatList.chats.slice(0, 12).map(c => c.name + " | " + (c.preview || ""))); break
                case 1: { const c = chatList.chats.find(c => /^OST TEST/.test(c.name)) || chatList.chats.find(c => c.name === "OST Test 2"); backend.selectChat(c.id, c.name); break }
                case 3: cap("after-chat"); break
                case 4: rail.current = "settings"; settingsView.pageForTest("general"); break
                case 5: settingsView.scrollToRegionalForTest(); break
                case 6: cap("after-settings"); break
                case 7: rail.current = "activity"; break
                case 8: cap("after-activity"); break
                case 9: rail.current = "calendar"; break
                case 11: cap("after-calendar"); break
                case 12: rail.current = "chat"; settingsView.pageForTest("general"); rail.current = "settings"; break
                case 13: cap("after-settings-top"); break
                case 14: { const before = JSON.parse(backend.setting("regionalTest")); keys.forEach((k, i) => backend.setSetting(k, before[i])); backend.setSetting("regionalTest", ""); log("restored", keys.map(k => backend.setting(k))); break }
                case 15: Qt.quit(); return
                }
            }
            step++
        }
    }

    // --translation-test: Settings ▸ General's Translation card, then the
    // chat with OST Test 2 (German OST TEST 139): Ask me shows "Translate |
    // Never translate German"; Never translate German hides it and adds the
    // chip; Auto-translate translates it by itself and See original brings
    // the suggestion back. Your settings are put back. Logs TRANSLATION lines.
    Timer {
        running: Qt.application.arguments.indexOf("--translation-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST Test 2")
        interval: 2500; repeat: true
        property int step: 0
        property var before: null
        onTriggered: {
            const log = (...a) => console.warn("TRANSLATION", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const msg = () => (backend.messagesJson ? JSON.parse(backend.messagesJson) : []).find(m => (m.text || "").indexOf("OST TEST 139") >= 0 || m.id === "1794701380280")
            const show = m => m ? { text: (m.text || "").slice(0, 60), suggest: m.suggest_translation, name: m.suggest_translation_name, translated: m.translated, from: m.translated_from } : null
            switch (step) {
            case 0: before = ["translationTarget", "translationMode", "translationKnown"].map(k => backend.setting(k)); ["translationTarget", "translationMode", "translationKnown"].forEach(k => backend.setSetting(k, "")); rail.current = "settings"; settingsView.pageForTest("general"); break
            case 2: settingsView.scrollToTranslationForTest(); log("settings", backend.translationSettingsJson(), "languages", JSON.parse(backend.translationLanguagesJson()).length); break
            case 3: cap("settings"); settingsView.openTranslationTargetForTest(true); break
            case 4: cap("languages"); break
            case 5: { settingsView.openTranslationTargetForTest(false); rail.current = "chat"; const c = chatList.chats.find(c => c.name === "OST Test 2"); backend.selectChat(c.id, c.name); break }
            case 6: log("ask", show(msg())); cap("ask"); break
            case 7: conversation.neverTranslate(msg().suggest_translation); break
            case 8: log("never", backend.translationSettingsJson(), show(msg())); cap("never"); break
            case 9: rail.current = "settings"; settingsView.pageForTest("general"); break
            case 10: settingsView.scrollToTranslationForTest(); break
            case 11: log("languages", JSON.parse(backend.translationLanguagesJson()).slice(0, 3)); cap("chips"); backend.setSetting("translationKnown", ""); backend.setSetting("translationMode", "ALWAYS_TRANSLATE"); break
            case 12: rail.current = "chat"; break
            case 15: log("auto", show(msg())); cap("auto"); break
            case 16: backend.translateMessage(msg().id, false); break
            case 17: log("original", show(msg())); cap("original"); break
            case 18: ["translationTarget", "translationMode", "translationKnown"].forEach((k, i) => backend.setSetting(k, before[i])); log("restored", backend.translationSettingsJson()); break
            case 19: Qt.quit(); return
            }
            step++
        }
    }

    // --leave-confirm-test: Settings ▸ General's Meeting and Time zone
    // cards, then "Ask me to confirm when I leave a meeting" on in a Meet
    // now in "OST group test": Leave asks (captured), then the call is
    // left; the setting is put back. Logs LEAVE lines.
    Timer {
        running: Qt.application.arguments.indexOf("--leave-confirm-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2500; repeat: true
        property int step: 0
        property string before: ""
        onTriggered: {
            const log = (...a) => console.warn("LEAVE", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            switch (step) {
            case 0: before = backend.setting("leaveConfirmation"); backend.setSetting("leaveConfirmation", "true"); rail.current = "settings"; settingsView.pageForTest("general"); break
            case 1: settingsView.scrollForTest(); break
            case 2: window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-general.png"))); break
            case 3: { rail.current = "chat"; const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name); break }
            case 4: backend.meetNow(); break
            case 9: log("call", backend.callState, "meeting", callWindow.meeting); callWindow.leaveAsked(); break
            case 10: callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-ask.png"))); log("still in call", backend.callState); break
            case 11: callWindow.leave(); break
            case 13: log("after", backend.callState); backend.setSetting("leaveConfirmation", before); break
            case 14: Qt.quit(); return
            }
            step++
        }
    }

    // --green-screen-test: Settings ▸ Devices' Video settings with the
    // camera on: Green Screen on (the detected colour, then a picked one),
    // with a background; then everything back. Logs GREEN lines.
    Timer {
        running: Qt.application.arguments.indexOf("--green-screen-test") >= 0 && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property var before: null
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const log = (...a) => console.warn("GREEN", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const fx = videoEffects
            switch (step) {
            case 0: before = { gs: fx.greenScreen, c: fx.greenScreenColor, b: fx.background }; fx.setGreenScreen(false); fx.setGreenScreenColor(""); window.showGreenScreenSettings(); break
            case 3: cap("devices"); break
            case 4: fx.setBackground("blur"); fx.setGreenScreen(true); settingsView.pageForTest("devices"); break
            case 7: log("detected", fx.detectedColor); cap("green-detected"); break
            case 8: fx.setGreenScreenColor(backend.previewColorAt(0.05, 0.5)); log("picked", fx.greenScreenColor); break
            case 10: cap("green-picked"); break
            case 11: fx.setGreenScreen(before.gs); fx.setGreenScreenColor(before.c); fx.setBackground(before.b); rail.current = "chat"; break
            case 13: log("done"); Qt.quit(); return
            }
            step++
        }
    }

    // The avatar's own video four times a second for 6 s after each
    // reaction (-self-<epoch ms>.png), only while the avatar is the camera.
    Timer {
        id: selfBurst
        interval: 250; repeat: true
        property double until: 0
        onTriggered: {
            if (Date.now() > until || !backend.avatarCamera()) { stop(); return }
            backend.saveVideoFrame("self", window.shotPath.replace(".png", "-self-" + Date.now() + ".png"))
        }
    }
    // --avatar-likes=<n>: n Likes 3 s apart from the call's step 33 (to see
    // which of them the avatar plays).
    Timer {
        id: likeLoop
        interval: 3000; repeat: true
        property int left: 0
        property int n: 0
        onTriggered: {
            if (left <= 0) { stop(); return }
            left--; n++
            callWindow.reactForTest("like")
            console.warn("AVATAR reacted like#" + n + " " + Date.now())
        }
    }
    // --avatar-test: Teams' avatars (its Avatars app, hosted by
    // AvatarHost) before joining (a Meet now's pre-join, never joined):
    // the app signed in and listing your avatars, the pre-join picker on
    // its Avatars tab with your first avatar chosen and previewed, the
    // pre-join Avatars pane, then the Avatars app's builder from the app
    // bar. With --avatar-call it then joins a Meet now (nobody else in
    // it) with the avatar as your video, opens Camera ▾ and the Video
    // effects and settings pane's Avatars tab, sends a Like (the avatar's
    // emote) and hangs up. Logs AVATAR lines.
    Timer {
        running: Qt.application.arguments.indexOf("--avatar-test") >= 0 && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property int waited: 0
        readonly property bool inCall: Qt.application.arguments.indexOf("--avatar-call") >= 0
        property int paneAt: 0
        onTriggered: {
            // (Never a picture of your camera: only while the avatar is the
            // camera.)
            const capPre = tag => { if (!backend.avatarCamera() || preJoin.cameraOn) { console.warn("AVATAR skipped capture", tag); return }
                preJoin.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png"))) }
            const capMain = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const capCall = tag => { if (!backend.avatarCamera()) { console.warn("AVATAR skipped capture", tag); return }
                callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png"))) }
            const log = (...a) => console.warn("AVATAR", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            switch (step) {
            case 0:
                log("app", avatarHost.app.url || "none", avatarHost.app.studio || "")
                if (!avatarHost.app.url && ++waited < 30) return
                waited = 0
                // In a call: Calendar's Meet now (a meeting of your own,
                // nobody invited); else a pre-join that is never joined.
                if (inCall) backend.calendarAction("meetNow", JSON.stringify({ subject: "OST avatar test" }))
                else preJoin.openMeetNow("", "OST avatar test")
                break
            case 1:
                if (!preJoin.visible && ++waited < 15) return
                waited = 0
                // Tall enough to show the whole picker.
                preJoin.height = 1060
                preJoin.effectsOpen = true; preJoin.pickerTab = "avatars"
                break
            case 2:
                if (!avatarHost.listed && ++waited < 60) return
                waited = 0
                log("listed", avatarHost.listed, avatarHost.avatars.map(a => a.name), avatarHost.backgrounds.length, "avatar camera", videoEffects.avatarCamera)
                capPre("picker-none")
                if (avatarHost.avatars.length === 0) { log("no avatars"); step = 20; return }
                videoEffects.selectAvatarBackground("")
                videoEffects.selectAvatar(avatarHost.avatars[0].id)
                break
            case 3:
                if (!backend.avatarDrawing() && ++waited < 90) return
                waited = 0
                log("drawing", backend.avatarDrawing(), "registered", avatarHost.registered, "applied", avatarHost.applied, "preview", preJoin.avatarPreview)
                break
            case 5: capPre("prejoin"); break
            case 6: preJoin.effectsPaneKind = "avatars"; preJoin.effectsPaneOpen = true; break
            case 12: capPre("prejoin-pane"); break
            case 13:
                preJoin.effectsPaneOpen = false
                if (inCall) { log("joining"); preJoin.joinNow(); step = 30; return }
                preJoin.cancel()
                break
            case 14: window.openAvatarBuilder(""); break
            case 26: capMain("builder"); break
            case 27: rail.current = "chat"; videoEffects.setAvatarCamera(false); log("done"); Qt.quit(); return
            // In the call.
            case 30:
                if (backend.callState !== "connected" && ++waited < 30) return
                waited = 0
                log("call", backend.callState, "camera", callWindow.cameraOn, "avatar camera", videoEffects.avatarCamera)
                // --avatar-guest: the meeting's link for a second account
                // (--join-test --join-url=…), and wait for it to join.
                if (Qt.application.arguments.indexOf("--avatar-guest") >= 0) log("join url", preJoin.joinUrl)
                break
            case 31:
                if (Qt.application.arguments.indexOf("--avatar-guest") >= 0 && callWindow.roster.length < 2 && ++waited < 120) return
                waited = 0
                log("roster", callWindow.roster.length)
                // Muted from here to the second Like (Teams' renderer gets no
                // visemes while you're muted).
                if (!backend.callMuted) backend.toggleMute()
                break
            // Your reaction, played by the avatar (the guest's frames show
            // it in the video itself).
            // A Like before Camera ▾ and the side pane are opened too.
            case 33: {
                const many = parseInt((Qt.application.arguments.find(x => x.startsWith("--avatar-likes=")) || "--avatar-likes=0").slice(15))
                if (many > 0) { likeLoop.left = many; likeLoop.n = 0; likeLoop.restart(); selfBurst.until = Date.now() + many * 3000 + 4000; selfBurst.restart(); waited = 0; break }
                callWindow.reactForTest("like"); selfBurst.until = Date.now() + 6000; selfBurst.restart(); log("reacted early like", Date.now()); break
            }
            // (While the Likes run.)
            case 34:
                if (likeLoop.running) return
                log("drawing in call", backend.avatarDrawing()); capCall("call"); break
            case 35: callWindow.videoOptionsForTest(); break
            case 36: capCall("flyout"); break
            case 37: callWindow.videoFlyoutForTest().close(); callWindow.videoEffectsPaneForTest().tab = "avatars"; callWindow.side = "video"; break
            // Like while muted (as Teams sends it with the mic off), laugh
            // with the mic on.
            case 40: callWindow.reactForTest("like"); selfBurst.until = Date.now() + 6000; selfBurst.restart(); log("reacted like", Date.now(), "muted", backend.callMuted); break
            case 42: callWindow.reactForTest("like"); selfBurst.until = Date.now() + 6000; selfBurst.restart(); log("reacted like again", Date.now()); break
            case 43: if (backend.callMuted) backend.toggleMute(); break
            case 44: capCall("pane"); break
            case 45: callWindow.reactForTest("laugh"); selfBurst.until = Date.now() + 6000; selfBurst.restart(); log("reacted laugh", Date.now(), "muted", backend.callMuted); break
            // Your hand up for 6 s: the app raises the avatar's hand.
            case 46: if (!callWindow.handRaised) backend.toggleHand(); log("hand raised", Date.now()); selfBurst.until = Date.now() + 6000; selfBurst.restart(); break
            case 47: capCall("reaction"); break
            // The guest leaving with the pane open: the pane after 2, 4, 8
            // and 16 s.
            case 48:
                if (Qt.application.arguments.indexOf("--avatar-guest") >= 0 && callWindow.roster.length > 1 && ++waited < 60) return
                waited = 0; log("alone again", callWindow.roster.length); paneAt = step
                break
            case 49: case 50: case 52: case 56: {
                if (step === 49 && callWindow.handRaised) backend.toggleHand()
                capCall("pane-left-" + (step - paneAt) * 2)
                const pg = callWindow.videoEffectsPaneForTest().avatarPanelForTest().pageForTest()
                if (pg) pg.stateForTest(r => log("pane page", step - paneAt, r))
                break
            }
            case 57: callWindow.side = ""; break
            case 58: log("hanging up"); backend.hangUp(); break
            case 61: log("call state", backend.callState); videoEffects.setAvatarCamera(false); log("done"); Qt.quit(); return
            }
            step++
        }
    }

    // --video-filters-test: Teams' Filters (its Custom Filters app, hosted
    // by VideoFilterHost) in a Meet now's pre-join (never joined): the
    // camera on, the Sweet style, then the Crystal frame, then None. Logs
    // VFILTER lines.
    Timer {
        running: Qt.application.arguments.indexOf("--video-filters-test") >= 0 && backend.signedIn
        interval: 2000; repeat: true
        property int step: 0
        property string before: ""
        onTriggered: {
            const cap = tag => preJoin.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const log = (...a) => console.warn("VFILTER", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const fx = videoEffects
            const pick = name => (fx.filters.filters || []).find(f => f.name === name)
            switch (step) {
            case 0: before = fx.filter; fx.setFilter(""); fx.setBackground("none"); preJoin.openMeetNow("", "OST filters test"); break
            case 1: preJoin.cameraOn = true; preJoin.effectsOpen = true; fx.load(); break
            case 3: log("filters", (fx.filters.filters || []).length, fx.filters.url, fx.quickFilters.map(f => f.name)); cap("none"); break
            case 4: fx.setFilter(pick("Sweet").id); break
            case 9: videoFilterHost.probe(3); break
            case 12: log("host ready", videoFilterHost.ready); cap("sweet"); break
            case 13: fx.setFilter(pick("Crystal").id); break
            case 17: log("host ready", videoFilterHost.ready); cap("crystal"); break
            case 18: preJoin.effectsPaneOpen = true; break
            case 19: cap("pane"); break
            case 20: preJoin.effectsPaneOpen = false; fx.setFilter(""); break
            case 21: cap("nofilter"); break
            case 22: preJoin.cameraOn = false; preJoin.cancel(); fx.setFilter(before); break
            case 23: log("done"); Qt.quit(); return
            }
            step++
        }
    }

    // --video-effects-test: Teams' video effects on the camera. Before
    // joining (a Meet now's pre-join, never joined): the camera on, the
    // effects picker with None, Standard blur, Portrait blur, a catalog
    // picture and an animated background, Adjust brightness and Soft focus,
    // then the "More video effects" pane. With --video-effects-call it then
    // starts a Meet now in "OST group test" with the camera on, opens
    // Camera ▾ and the Video effects and settings pane (both tabs), adds
    // /tmp/ost-bg-test.jpg with Add new (and the too small
    // /tmp/ost-bg-small.png), opens Show all, removes the upload and
    // hangs up (--video-effects-hold: after two minutes with a catalog
    // picture behind you). The effects are put back as they were. Logs VFX
    // lines.
    Timer {
        running: Qt.application.arguments.indexOf("--video-effects-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        property int holdSteps: 0
        property var before: null
        onTriggered: {
            const capPre = tag => preJoin.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const capCall = tag => callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const log = (...a) => console.warn("VFX", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const fx = videoEffects
            const pic = () => fx.catalog.find(e => !e.animated)
            const anim = () => fx.catalog.find(e => e.animated)
            const inCall = Qt.application.arguments.indexOf("--video-effects-call") >= 0
            // --video-effects-hold: stay two minutes in the call with a
            // catalog picture behind you (to watch from another client).
            const hold = Qt.application.arguments.indexOf("--video-effects-hold") >= 0
            switch (step) {
            case 0: before = { b: fx.background, k: fx.blurKind, br: fx.brightness, sf: fx.softFocus, m: fx.mirror }; log("before", before); fx.setBackground("none"); fx.setBrightness(false); fx.setSoftFocus(false); preJoin.openMeetNow("", "OST effects test"); break
            case 1: preJoin.cameraOn = true; preJoin.effectsOpen = true; fx.load(); break
            case 3: log("catalog", fx.catalog.length, fx.catalog.slice(0, 2)); capPre("none"); break
            case 4: fx.setBackground("blur"); break
            case 6: capPre("blur"); break
            case 7: fx.setBlur("portrait"); break
            case 9: capPre("portrait"); break
            case 10: fx.setBlur("standard"); fx.setBackground(pic().id); log("picture", pic().name); break
            case 14: capPre("picture"); break
            case 15: fx.setBackground(anim().id); log("animated", anim().name); break
            case 19: capPre("animated"); break
            case 20: capPre("animated2"); break
            case 21: fx.setBackground("none"); fx.setBrightness(true); break
            case 23: capPre("brightness"); break
            case 24: fx.setBrightness(false); fx.setSoftFocus(true); break
            case 26: capPre("softfocus"); break
            case 27: fx.setSoftFocus(false); fx.setBackground("blur"); preJoin.effectsPaneOpen = true; break
            case 29: capPre("pane"); break
            case 30: preJoin.effectsPaneOpen = false; preJoin.cameraOn = false; break
            case 31: capPre("cameraoff"); break
            case 32: preJoin.cancel(); if (!inCall) step = 61; break
            case 33: { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name); break }
            case 34: backend.meetNow(); break
            case 40: log("call", backend.callState); if (!callWindow.cameraOn) callWindow.runControl("VideoButton"); break
            case 43: callWindow.videoOptionsForTest(); break
            case 45: capCall("flyout"); break
            case 46: callWindow.videoFlyoutForTest().close(); callWindow.side = "video"; break
            case 48: capCall("callpane"); break
            case 49: callWindow.videoEffectsPaneForTest().tab = "settings"; break
            case 50: capCall("settings"); break
            case 51: { const pane = callWindow.videoEffectsPaneForTest(); pane.tab = "effects"; log("add", pane.addForTest("/tmp/ost-bg-test.jpg"), fx.background) } break
            case 52: capCall("added"); break
            case 53: callWindow.videoOptionsForTest(); break
            case 54: capCall("uploadflyout"); break
            case 55: callWindow.videoFlyoutForTest().close(); log("upload too small", callWindow.videoEffectsPaneForTest().addForTest("/tmp/ost-bg-small.png")); break
            case 56: capCall("toosmall"); break
            case 57: callWindow.videoEffectsPaneForTest().showAll = true; break
            case 58: capCall("showall"); break
            case 59: { const u = fx.uploads[fx.uploads.length - 1]; log("uploads", fx.uploads.length); callWindow.videoEffectsPaneForTest().notice = fx.removeUpload(u.id) } break
            case 60: capCall("removed"); log("after remove", fx.uploads.length, fx.background); if (hold) { callWindow.side = ""; fx.setBackground(pic().id); log("holding with", pic().name) } break
            case 61: if (hold && holdSteps++ < 60) return; if (inCall) backend.hangUp(); break
            case 62: fx.setBlur(before.k); fx.setBackground(before.b); fx.setBrightness(before.br); fx.setSoftFocus(before.sf); fx.setMirror(before.m); break
            case 64: log("after", backend.callState, { b: fx.background, k: fx.blurKind }); Qt.quit(); return
            }
            step++
        }
    }

    // --content-camera-test[=whiteboard|document|video] (TASK-0214):
    // Teams' Content from camera setup dialog over the main window, no
    // call: its info (Don't show again left alone), Got it, the preview
    // while it looks for the board ("Looking for a whiteboard"), once the
    // edges are found (the processed frame saved), Overlay presenter off
    // and on, Rotate (and three more back), Scan Again, Detect edges off,
    // then closed. Run with OST_CAMERA_DEVICE=<test camera>. CCAM lines;
    // pictures -ccam-*.png. --content-camera-fail: wait for the 11 s
    // "Couldn't detect edges" path instead (a camera without a board).
    Loader {
        id: ccamTest
        active: Qt.application.arguments.some(a => a.startsWith("--content-camera-test"))
        sourceComponent: Component { ContentCameraDialog { } }
    }
    Timer {
        running: ccamTest.status === Loader.Ready
        interval: 1000; repeat: true
        property int step: 0
        property int found: 0
        onTriggered: {
            const a = Qt.application.arguments.find(x => x.startsWith("--content-camera-test"))
            const type = a.indexOf("=") > 0 ? a.slice(a.indexOf("=") + 1) : "whiteboard"
            const fail = Qt.application.arguments.indexOf("--content-camera-fail") >= 0
            const dlg = ccamTest.item
            const shot = n => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-ccam-" + n + ".png")))
            const log = t => console.warn("CCAM", t, JSON.stringify({ info: dlg.infoView, detecting: dlg.detecting, preview: dlg.previewRunning, share: dlg.shareEnabled,
                                                                       toast: dlg.toast ? dlg.toastText : "", quadOn: dlg.quadOn, cleanupOn: dlg.cleanupOn, size: [dlg.width, dlg.height] }), backend.contentCameraState())
            const f = found
            if (step === 0) { dlg.openFor(type) }
            else if (step === 2) { log("opened"); shot(dlg.infoView ? "info" : "opened") }
            else if (step === 3) { if (dlg.infoView) dlg.gotIt() }
            else if (step === 5) { log("preview"); shot("looking") }
            else if (fail) {
                if (step === 13) { log("before timeout"); shot("still-looking") }
                else if (step === 17) { log("timed out"); shot("no-edges") }
                else if (step === 25) { log("toast gone"); shot("no-edges-after") }
                else if (step === 26) { dlg.close(); log("closed") }
                else if (step === 28) { log("done"); Qt.quit() }
            }
            else if (step > 5 && !f && (!dlg.detecting || step === 20) && dlg.previewRunning) {
                found = step; log("detected"); shot("detected"); backend.saveVideoFrame("content-camera", window.shotPath.replace(".png", "-ccam-preview.png"))
            }
            else if (f && step === f + 1) dlg.toggleCleanup()
            else if (f && step === f + 3) { log("overlay off"); shot("overlay-off") }
            else if (f && step === f + 4) dlg.toggleCleanup()
            else if (f && step === f + 8) { log("overlay on"); shot("overlay-on"); backend.saveVideoFrame("content-camera", window.shotPath.replace(".png", "-ccam-overlay-frame.png")) }
            else if (f && step === f + 9) dlg.rotate()
            else if (f && step === f + 11) { log("rotated"); shot("rotated") }
            else if (f && step === f + 12) { dlg.rotate(); dlg.rotate(); dlg.rotate() }
            else if (f && step === f + 14) { log("rotated back"); dlg.scanAgain() }
            else if (f && step === f + 15) { log("scan again"); shot("scan-again") }
            else if (f && step === f + 23) { log("after scan again"); dlg.toggleEdges() }
            else if (f && step === f + 25) { log("edges off"); shot("edges-off") }
            else if (f && step === f + 26) { dlg.close(); log("closed") }
            else if (f && step === f + 28) { log("done"); Qt.quit() }
            else if (step === 60) { log("gave up"); Qt.quit() }
            step++
        }
    }

    // --meet-now-test: Meet now in "OST group test" (with --meet-join, join
    // its ongoing call instead), stay 50 s (capturing the header before and
    // in the call, and the call window), log the call state, hang up.
    Timer {
        running: Qt.application.arguments.indexOf("--meet-now-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2500; repeat: true
        property int step: 0
        onTriggered: {
            if (step === 0) { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name) }
            else if (step === 1) window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-header.png")))
            else if (step === 2) { if (Qt.application.arguments.indexOf("--meet-join") >= 0) backend.joinGroupCall(); else backend.meetNow() }
            else if (step === 6) window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-incall.png")))
            else if (step === 8) { console.warn("MEETNOW state", backend.callState, "meeting", backend.callMeeting, "thread", backend.callThreadId, "roster", backend.callRosterJson); callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-meetnow.png"))) }
            else if (step === 7 && Qt.application.arguments.indexOf("--meet-unmute") >= 0 && backend.callMuted) backend.toggleMute()
            else if (step >= 9 && step <= 21) console.warn("MEETNOW media muted", backend.callMuted, "camera", backend.callCameraOn, "sharing", backend.callSharing)
            else if (step === 22) backend.hangUp()
            else if (step === 26) { console.warn("MEETNOW after", backend.callState); Qt.quit() }
            step++
        }
    }

    // --group-call-nmc=<chat name> ("~" for spaces): TASK-0208's group call
    // check. Joins the chat's ongoing group call (--group-call-start calls
    // the chat instead), then logs and captures the bar and More with New
    // meeting controls off and on, at 1280 and 856 (the setting is put
    // back), and hangs up. GCNMC lines; pictures -gc-*.png.
    Timer {
        readonly property string chat: (Qt.application.arguments.find(a => a.startsWith("--group-call-nmc=")) || "").slice(17).replace(/~/g, " ")
        running: chat.length > 0 && backend.signedIn && chatList.chats.some(c => c.name === chat)
        interval: 2500; repeat: true
        property int step: 0
        property string was: ""
        // --group-call-stay=<s>: stay that much longer before hanging up.
        readonly property int stay: Math.round(Number((Qt.application.arguments.find(a => a.startsWith("--group-call-stay=")) || "=0").split("=")[1]) / 2.5)
        onTriggered: {
            const shot = n => callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-gc-" + n + ".png")))
            const log = t => console.warn("GCNMC", t, callWindow.width, backend.callState, "scheduled", callWindow.scheduled, "adhoc", callWindow.adhocMeeting,
                                          "organizer", callWindow.organizer, "role", callWindow.myRole, JSON.stringify(callWindow.ubar))
            const setNmc = on => { backend.setSetting("newMeetingControls", on ? "true" : "false"); callWindow.newControls = on }
            const answer = Qt.application.arguments.indexOf("--group-call-answer") >= 0
            if (step === 0) { const c = chatList.chats.find(c => c.name === chat); backend.selectChat(c.id, c.name) }
            else if (step === 1) {
                // --group-call-answer: wait for the chat's call to ring here, then answer it (audio only).
                if (answer && backend.callState !== "ringing") return
                if (answer) backend.acceptCall(false)
                else if (Qt.application.arguments.indexOf("--group-call-start") >= 0) backend.startCall()
                // --group-call-huddle: the chat's Meet now (nobody rung).
                else if (Qt.application.arguments.indexOf("--group-call-huddle") >= 0) backend.meetNow()
                else backend.joinGroupCall()
            }
            else if (step === 4 && !backend.callMuted) backend.toggleMute()
            else if (step === 8) { was = backend.setting("newMeetingControls"); setNmc(false); callWindow.side = ""; callWindow.width = 1280 }
            else if (step === 9) { log("off-1280"); shot("off-1280") }
            else if (step === 10) callWindow.width = 856
            else if (step === 11) { log("off-856"); shot("off-856") }
            else if (step === 12) { setNmc(true); callWindow.width = 1280 }
            else if (step === 13) { log("on-1280"); shot("on-1280") }
            else if (step === 14) callWindow.newMoreForTest()
            else if (step === 15) {
                shot("on-more")
                console.warn("GCNMC grid", JSON.stringify(callWindow.newGridItems.map(e => e.label)), "list",
                             JSON.stringify(callWindow.newListItems.map(e => (e.label || "|") + (e.submenu ? " [" + e.submenu.map(s => s.label || "|").join(", ") + "]" : ""))))
            }
            else if (step === 16) { callWindow.closeMenusForTest(); setNmc(was === "true") }
            else if (step === 17 + stay) { console.warn("GCNMC leaving", backend.callState); backend.hangUp() }
            else if (step === 20 + stay) { console.warn("GCNMC after", backend.callState); Qt.quit() }
            else if (step > 17 && step < 17 + stay && step % 8 === 0) console.warn("GCNMC staying", backend.callState, "roster", backend.callRosterJson.length)
            step++
        }
    }

    // --open-file-test: Settings ▸ Files and links' "Always open Word,
    // PowerPoint, and Excel files in", then ost-open-test.docx opened with
    // Desktop app chosen (by its drive item, then by its address); the
    // setting is put back afterwards.
    Timer {
        running: Qt.application.arguments.indexOf("--open-file-test") >= 0 && backend.signedIn
        interval: 3000; repeat: true
        property int step: 0
        property string before: ""
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const f = (oneDrive.driveData.items || []).find(i => i.name === "ost-open-test.docx")
            if (step === 0) { before = backend.setting("fileOpenIn"); console.warn("OPENFILE app", JSON.stringify(backend.officeAppName()), "setting", JSON.stringify(before)); rail.current = "settings"; settingsView.pageForTest("files") }
            else if (step === 1) cap("settings")
            else if (step === 2) { backend.setSetting("fileOpenIn", "desktop"); rail.current = "onedrive"; oneDrive.open("myfiles") }
            else if (step === 4) { console.warn("OPENFILE item", !!f); if (f) backend.openFile(f.web_url, f.name, JSON.stringify(f)) }
            else if (step === 7 && f) backend.openFile(f.web_url, f.name, "")
            else if (step === 10) { backend.setSetting("fileOpenIn", before); console.warn("OPENFILE restored", JSON.stringify(backend.setting("fileOpenIn"))); Qt.quit() }
            step++
        }
    }

    // --column-settings-test (TASK-0189): My files' columns at --size: the
    // responsive widths, each header's menu, Widen column on Modified (+32),
    // a "drag" of Modified By to 200, Narrow column back under its
    // responsive width (no change shown), the setting kept; then the widths
    // are reset. COLSET lines; pictures column-settings-*.png.
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--column-settings-test")) && backend.signedIn
        interval: 1500; repeat: true
        property int step: 0
        onTriggered: {
            const shots = (Qt.application.arguments.find(a => a.startsWith("--shots=")) || "--shots=/tmp").slice(8)
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(shots + "/column-settings-" + tag + ".png"))
            const log = (tag, x) => console.warn("COLSET", tag, JSON.stringify(x === undefined ? oneDrive.columnsForTest() : x))
            const d = oneDrive.driveData
            if (step === 0) { rail.current = "onedrive"; oneDrive.open("myfiles") }
            else if (step === 2 && !(d.items || []).length) return
            else if (step === 2) { oneDrive.columnResetForTest(); log("start") }
            else if (step === 3) { cap("start"); for (const c of ["name", "modified", "modified_by", "size", "sharing", ""]) log("menu " + (c || "activity"), oneDrive.columnMenuForTest(c)) }
            else if (step === 4) cap("menu-sharing")
            else if (step === 5) { oneDrive.columnMenuForTest("modified"); }
            else if (step === 6) cap("menu-modified")
            else if (step === 7) { const h = oneDrive.columnHeadForTest("modified"); h.pickForTest(3, 0); log("widened modified") }
            else if (step === 8) { cap("widened"); oneDrive.columnDragForTest("modified_by", 200); log("dragged modified_by to 200") }
            else if (step === 9) { cap("dragged"); oneDrive.columnResizeForTest("size", false); oneDrive.columnResizeForTest("size", false); log("narrowed size twice") }
            else if (step === 10) { log("kept", backend.setting("oneDriveColumnWidths")); cap("narrowed") }
            else if (step === 11) { oneDrive.columnResetForTest(); log("reset") }
            else if (step === 12) Qt.quit()
            step++
        }
    }
    // --filter-by-test (TASK-0236): My files' Filter by as Teams' OneDrive
    // app: the Modified By and Modified menus, the Modified By pane (its
    // editors and @Me), SharePoint App ticked and applied (the bar, the
    // funnel, the narrowed rows), OST Test 1 added (two values), the
    // Modified pane with one date added, the people box typed
    // (--filter-person=<name>, default OST Test 2) and that person picked
    // with @Me, a chip's X, then Clear. FILTERBY lines; pictures
    // filter-by-*.png.
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--filter-by-test")) && backend.signedIn
        interval: 1500; repeat: true
        property int step: 0
        property int wait: 0
        property int rows: 0
        onTriggered: {
            const shots = (Qt.application.arguments.find(a => a.startsWith("--shots=")) || "--shots=/tmp").slice(8)
            const cap = t => window.contentItem.grabToImage(r => r.saveToFile(shots + "/filter-by-" + t + ".png"))
            const person = (Qt.application.arguments.find(a => a.startsWith("--filter-person=")) || "--filter-person=OST Test 2").slice(16)
            const log = (t, x) => console.warn("FILTERBY", t, JSON.stringify(x === undefined ? oneDrive.filtersForTest() : x))
            const pane = oneDrive.filterPaneStateForTest()
            const d = oneDrive.driveData
            const served = () => pane.served && pane.served.values !== undefined
            const until = (ok, t) => { if (!ok && ++wait < 20) return false; if (!ok) log("timed out " + t, pane); wait = 0; return true }
            if (step === 0) { rail.current = "onedrive"; oneDrive.open("myfiles") }
            else if (step === 2 && !(d.items || []).length) return
            else if (step === 2) { rows = d.items.length; log("start"); log("menu modified_by", oneDrive.columnMenuForTest("modified_by")); log("menu modified", oneDrive.columnMenuForTest("modified")) }
            else if (step === 3) { cap("menu-modified"); oneDrive.filterPaneForTest("Editor") }
            else if (step === 4) { if (!until(served(), "editor values")) return; log("editor pane", pane); cap("pane-editor") }
            else if (step === 5) { log("ticked", oneDrive.filterTickForTest("SharePoint App")); cap("pane-ticked") }
            else if (step === 6) oneDrive.filterApplyForTest()
            else if (step === 7) { if (!until(!backend.driveBusy && oneDrive.filtersForTest().filters.length > 0, "apply")) return; log("filtered"); log("menu modified_by", oneDrive.columnMenuForTest("modified_by")) }
            else if (step === 8) { cap("filtered"); oneDrive.filterPaneForTest("Editor") }
            else if (step === 9) { if (!until(served(), "editor values 2")) return; oneDrive.filterTickForTest("OST Test 1"); oneDrive.filterApplyForTest() }
            else if (step === 10) { if (!until(!backend.driveBusy, "apply 2")) return; log("two editors") }
            else if (step === 11) { cap("two-editors"); oneDrive.filterPaneForTest("Modified") }
            else if (step === 12) { if (!until(served(), "dates")) return; log("modified pane", pane); cap("pane-modified") }
            else if (step === 13) { const v = (pane.served.values || [])[0]; log("ticked date", v ? oneDrive.filterTickForTest(v.value) : null); oneDrive.filterApplyForTest() }
            else if (step === 14) { if (!until(!backend.driveBusy, "apply date")) return; log("date and editors") }
            else if (step === 15) { cap("date-and-editors"); oneDrive.filterPaneForTest("Editor") }
            else if (step === 16) { if (!until(served(), "editor values 3")) return; oneDrive.filterTypeForTest(person) }
            else if (step === 17) { if (!until(oneDrive.filterPickPersonForTest(person), "people")) return; log("picked " + person, pane); cap("pane-person") }
            else if (step === 18) { oneDrive.filterTickForTest("@Me"); log("with @Me", pane); oneDrive.filterApplyForTest() }
            else if (step === 19) { if (!until(!backend.driveBusy, "apply me")) return; log("with me and a person") }
            else if (step === 20) { cap("me"); const f = oneDrive.filtersForTest().filters.find(x => x.field === "Modified"); if (f) oneDrive.removeFilterValue("Modified", f.values[0]) }
            else if (step === 21) { if (!until(!backend.driveBusy, "chip")) return; log("date chip removed") }
            else if (step === 22) backend.driveSetFilters("[]")
            else if (step === 23) { if (!until(!backend.driveBusy, "clear")) return; log("cleared", { filters: oneDrive.filtersForTest().filters, rows: (oneDrive.driveData.items || []).length, before: rows }); cap("cleared") }
            else if (step === 24) Qt.quit()
            step++
        }
    }
    // --preview-bar-test (TASK-0190): Preview of ost-share-test.txt at
    // --size: the bar (which left items show, the title, the right group),
    // ··· and Share ▾, Show comments (the pane, a comment typed when
    // --preview-comment=<text> and then deleted), Embed. PREVIEWBAR lines;
    // pictures preview-bar-*.png.

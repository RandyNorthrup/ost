    // --group-call-test: call the "OST group test" chat, stay 50 s,
    // capture the call window and People, hang up.
    Timer {
        running: Qt.application.arguments.indexOf("--group-call-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2500; repeat: true
        property int step: 0
        onTriggered: {
            if (step === 0) { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name) }
            else if (step === 1) backend.startCall()
            else if (step === 20) {
                console.warn("GROUPCALL state", backend.callState, "meeting", backend.callMeeting, "roster", backend.callRosterJson)
                callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-group.png")))
                callWindow.side = "people"
            } else if (step === 21) callWindow.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-grouppeople.png")))
            else if (step === 22) backend.hangUp()
            else if (step === 24) Qt.quit()
            step++
        }
    }

    // --custom-emoji-test=<png>: add "ost-test" for the org from <png>,
    // capture the dialog and the picker's Custom section, send it in "OST
    // group test" in a message and react to that message with it.
    // --custom-emoji-delete: delete "ost-test" for the org.
    Timer {
        readonly property string png: (Qt.application.arguments.find(a => a.startsWith("--custom-emoji-test=")) || "").slice(20)
        readonly property bool deleting: Qt.application.arguments.indexOf("--custom-emoji-delete") >= 0
        running: (png.length > 0 || deleting) && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2500; repeat: true
        property int step: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-" + tag + ".png")))
            const org = () => backend.customEmojiJson ? JSON.parse(backend.customEmojiJson) : []
            const want = (Qt.application.arguments.find(a => a.startsWith("--custom-emoji-name=")) || "--custom-emoji-name=ost-test").slice(20)
            const mine = () => org().find(e => e.shortcut === want)
            const add = conversation.customEmojiAddForTest(), p = conversation.funPickerForTest()
            if (step === 0) { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name); backend.loadCustomEmoji() }
            else if (step === 2 && deleting) {
                const e = mine(); console.warn("CUSTOM delete", e ? e.id : "none")
                if (e) backend.deleteCustomEmoji(e.id)
            }
            else if (step === 5 && deleting) { backend.loadCustomEmoji() }
            else if (step === 7 && deleting) { console.warn("CUSTOM after delete", JSON.stringify(org().map(e => e.shortcut))); Qt.quit() }
            else if (deleting) {}
            else if (step === 2) { console.warn("CUSTOM before", org().length); add.startWith("file://" + png) }
            else if (step === 4) { console.warn("CUSTOM name", add.nameForTest); cap("dialog") }
            else if (step >= 5 && step <= 8 && !mine() && !add.busyForTest) { if (add.nameForTest !== want) add.setNameForTest(want); console.warn("CUSTOM add pressed", add.addForTest()) }
            else if (step === 9) { console.warn("CUSTOM result", backend.customEmojiResult, JSON.stringify(org())); cap("added") }
            else if (step === 10) { conversation.openEmojiForTest(); p.tab = "emoji" }
            else if (step === 11) p.tab = "emoji"
            else if (step === 12) { const e = mine(); if (e) backend.emoticonUrl(e.id, 20) }
            else if (step === 13) cap("picker")
            // --custom-emoji-nosend: stop at the picker (nothing posted).
            else if (step === 14 && Qt.application.arguments.indexOf("--custom-emoji-nosend") >= 0) { p.close(); Qt.quit() }
            else if (step === 14) { const e = mine(); p.close(); conversation.insertTextForTest("OST test 58: our custom emoji "); if (e) p.pickedEmoji(e.id) }
            else if (step === 15) { console.warn("CUSTOM compose", JSON.stringify(conversation.composeMediaForTest())); conversation.sendForTest() }
            else if (step === 20) {
                const e = mine(), msgs = JSON.parse(backend.messagesJson || "[]")
                const m = msgs.filter(m => (m.text || "").indexOf("OST test 58") >= 0).pop()
                console.warn("CUSTOM sent", m ? m.id + " " + m.text : "not found")
                if (m && e) backend.toggleReaction(m.id, e.id, true)
            }
            else if (step === 26) { cap("timeline"); }
            else if (step === 27) Qt.quit()
            step++
        }
    }

    // --copilot-test: Write with Copilot in OST group test (or, with
    // --copilot-channel, OST Test Team > OST test channel 2): the button,
    // the popover with an empty box, a harmless test draft, Rewrite (its
    // loading and answer), Proofread, Adjust ▸ Concise and the menu, Custom
    // ("add a cheerful good morning"), Previous, then Replace; the box is
    // cleared at the end and nothing is sent. Logs COPILOT lines; pictures
    // copilot-*.png.
    Timer {
        running: Qt.application.arguments.indexOf("--copilot-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 1500; repeat: true
        property int step: 0
        property int waited: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-copilot-" + tag + ".png")))
            const log = (...a) => console.warn("COPILOT", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const chan = Qt.application.arguments.indexOf("--copilot-channel") >= 0
            const box = conversation.composeForTest()
            const pop = box ? box.copilotForTest() : null
            const settle = () => { const st = pop.stateForTest(); if (st.busy && waited++ < 40) return false; waited = 0; return true }
            switch (step) {
            case 0:
                if (chan) {
                    const team = (backend.teamsJson ? JSON.parse(backend.teamsJson) : []).find(t => t.name === "OST Test Team")
                    const ch = team ? team.channels.find(c => c.name === "OST test channel 2") : null
                    if (!ch) return
                    backend.selectChat(ch.id, ch.name)
                } else { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name) }
                break
            case 2: log("state", backend.composeCopilotJson, "button", box.toolModel.map(t => t.id)); box.clearForTest(); box.openCopilot(null); break
            case 3: log("empty", pop.stateForTest()); cap("empty"); pop.close(); break
            case 4: conversation.setComposeText("hey team can we meet tmrw at 10 to go over the test plan thx"); break
            case 5: box.openCopilot(null); break
            case 6: log("ready", pop.stateForTest()); cap("ready"); pop.actForTest("rewrite"); break
            case 7: cap("loading"); log("loading", pop.stateForTest()); break
            case 8: if (!settle()) return; log("rewrite", pop.stateForTest().answers); cap("rewrite"); pop.actForTest("proofread"); break
            case 9: if (!settle()) return; log("proofread", pop.stateForTest().answers.slice(-1)); cap("proofread"); pop.actForTest("concise"); break
            case 10: if (!settle()) return; log("concise", pop.stateForTest().answers.slice(-1)); pop.actForTest("menu"); break
            case 11: cap("menu"); pop.actForTest("custom", "add a cheerful good morning"); break
            case 12: if (!settle()) return; log("custom", pop.stateForTest()); cap("custom"); pop.actForTest("prev"); break
            case 13: log("prev", pop.stateForTest().index); cap("prev"); pop.actForTest("replace"); break
            case 14: log("replaced", box.plainText(), "open", pop.opened); cap("replaced"); break
            case 15: box.clearForTest(); conversation.setComposeText(""); break
            case 16: Qt.quit(); return
            }
            step++
        }
    }

    // --attach-link-test: in OST group test, a suggested file (the Attach
    // popover's first) into the compose box, its card's Link settings
    // ("People currently in this chat", applied: the link is made), then,
    // with --attach-link-send, sent as "OST TEST 173 link settings from
    // OST". Logs ATTACHLINK lines; pictures attach-link-*.png.
    Timer {
        running: Qt.application.arguments.indexOf("--attach-link-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        property int waited: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-attach-link-" + tag + ".png")))
            const log = (...a) => console.warn("ATTACHLINK", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const m = conversation.attachMenuForTest(), ca = conversation.cloudAttachForTest()
            switch (step) {
            case 0: { const c = chatList.chats.find(c => c.name === "OST group test"); backend.selectChat(c.id, c.name); break }
            case 2: conversation.attachFile(); break
            case 4: { const st = m.stateForTest(); if (st.loading && waited++ < 10) return; waited = 0; log("menu", st); cap("menu"); break }
            case 5: { const h = m.hits[0]; log("pick", h || null); if (!h) { Qt.quit(); return } m.close(); m.picked(h); break }
            case 6: { const st = ca.stateForTest(); if (st.some(c => c.loading) && waited++ < 20) return; waited = 0; log("card", st); cap("card"); break }
            case 7: ca.openLink(ca.pending[0].key); break
            case 9: { const d = ca.linkDialogForTest(); log("dialog", d.view, d.chatMode); cap("dialog"); d.pendScope = 4; d.pendEdit = true; break }
            case 10: { const d = ca.linkDialogForTest(); cap("dialog-chat"); d.linkChosen(4, true, "", ""); d.close(); break }
            case 11: { const st = ca.stateForTest(); if (st.some(c => c.linking) && waited++ < 20) return; waited = 0; log("linked", st); cap("linked"); break }
            case 12: if (Qt.application.arguments.indexOf("--attach-link-send") < 0) { ca.clear(); Qt.quit(); return } conversation.setComposeText("OST TEST 173 link settings from OST"); break
            case 13: conversation.sendForTest(); break
            case 17: log("sent; status", backend.statusText); cap("sent"); Qt.quit(); return
            }
            step++
        }
    }

    // --open-chat-named=<name start> (~ for spaces): open the first chat whose
    // name starts with it, log its id, its kind (backroom) and its newest
    // rows (CHATNAMED lines: system rows' text, call rows and recap cards),
    // capture chat-named.png at the newest messages, then quit.
    Timer {
        readonly property string want: { const a = Qt.application.arguments.find(a => a.startsWith("--open-chat-named=")); return a ? a.slice(18).replace(/~/g, " ") : "" }
        running: want.length > 0 && backend.signedIn && chatList.chats.length > 0
        interval: 3000; repeat: true
        property int step: 0
        property int waited: 0
        onTriggered: {
            const log = (...a) => console.warn("CHATNAMED", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const all = chatList.chats.filter(c => (c.name || "").indexOf(want) >= 0)
            // Several chats can share the name (a meeting's chat and its
            // group chat): the last one asked for with --open-chat-index.
            const ia = Qt.application.arguments.find(a => a.startsWith("--open-chat-index="))
            const c = all[ia ? Number(ia.slice(18)) : 0]
            if (step === 0 && all.length > 1) log("same name", all.map(x => ({ id: x.id, backroom: x.backroom || "" })))
            if (!c) {
                if (waited++ === 5) log("none; backroom chats", chatList.chats.filter(x => x.backroom).map(x => x.name + " [" + x.backroom + "]"))
                if (waited > 20) Qt.quit()
                return
            }
            if (step === 0) { log("chat", { id: c.id, name: c.name, backroom: c.backroom || "", topic: c.topic || "", creator: !!c.isCreator }); backend.selectChat(c.id, c.name) }
            else if (step === 3) {
                conversation.jumpToNewest()
                for (const m of (conversation.messages || []).slice(-12))
                    log("row", { kind: m.kind, state: m.call_state || "", text: String(m.text || "").slice(0, 160), recap: m.recap ? { subject: m.recap.subject, start: m.recap.start, end: m.recap.end, recs: (m.recap.recordings || []).map(r => ({ s: r.duration_seconds, days: r.expires_days, thumb: !!r.thumb_local })), transcript: m.recap.transcript } : null })
            } else if (step === 5) window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-chat-named.png")))
            else if (step === 7) { Qt.quit(); return }
            step++
        }
    }

    // --delete-test-messages=<id,id…>: in OST group test, delete those of
    // your own test messages (as Delete does), one every 3 s; then quit.
    Timer {
        readonly property var ids: { const a = Qt.application.arguments.find(a => a.startsWith("--delete-test-messages=")); return a ? a.slice(23).split(",").filter(x => x) : [] }
        running: ids.length > 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 3000; repeat: true
        property int step: 0
        onTriggered: {
            if (step === 0) { const ch = chatList.chats.find(x => x.name === "OST group test"); backend.selectChat(ch.id, ch.name) }
            else if (step - 2 < ids.length && step >= 2) { console.warn("DELETETEST", ids[step - 2]); backend.deleteMessage(ids[step - 2]) }
            else if (step >= 2) { Qt.quit(); return }
            step++
        }
    }

    // --compose-apps-test: in OST group test, "+" lists your installed apps
    // with compose commands (COMPOSEAPPS apps line, compose-apps-menu.png);
    // then Polls' action opens its task module (fetchTask; picture after 12
    // s, then closed: nothing is posted) and Power BI's search panel
    // (compose-apps-search.png, closed).
    Timer {
        running: Qt.application.arguments.indexOf("--compose-apps-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-compose-apps-" + tag + ".png")))
            const log = (...a) => console.warn("COMPOSEAPPS", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const c = conversation.composeForTest(), t = conversation.composeAppsForTest()
            const app = name => t.apps.find(a => a.name === name)
            switch (step) {
            case 0: { const ch = chatList.chats.find(x => x.name === "OST group test"); backend.selectChat(ch.id, ch.name); break }
            case 2: c.openPlusForTest(); break
            case 5: log("apps", t.apps.map(a => a.name + ":" + (a.commands || []).map(k => k.type + (k.fetchTask ? "/fetch" : k.taskInfo && k.taskInfo.url ? "/page" : "")).join(","))); log("suggested", c.suggestedApps.map(a => a.name + " " + (a.count > 0 ? a.averageText + " (" + a.countText + ")" : "none") + (a.agent ? " agent" : ""))); cap("menu"); break
            case 6: c.closePlusForTest(); { const a = app("Polls"); if (a) conversation.runComposeCommand(a, a.commands[0], c) } break
            case 12: { const d = conversation.composeAppsForTest().task; log("task", d ? d.stateForTest() : null); cap("task"); if (d) d.close() } break
            case 13: { const a = app("Power BI"); if (a) conversation.runComposeCommand(a, a.commands.find(k => k.type === "query") || a.commands[0], c) } break
            case 17: { const p = t.panel; log("panel", { open: p.opened, error: p.error, results: p.results.length }); cap("search"); p.close(); log("suggested later", c.suggestedApps.map(a => a.name + " " + (a.count > 0 ? a.averageText + " (" + a.countText + ")" : "none") + (a.agent ? " agent" : ""))) } break
            case 18: Qt.quit(); return
            }
            step++
        }
    }

    // --loop-compose-test: in OST group test (or --open-chat=<id>), Teams'
    // Loop components button puts Loop's paragraph in the compose box; once
    // made and linked, a title and a line are typed into it as keys. Then
    // --loop-compose-send sends it with "OST TEST 85 loop from OST" and
    // checks the message shows the component; --loop-compose-discard
    // discards it instead (Discard draft message ▸ Discard: the file goes).
    // Logs LOOPCOMPOSE lines; pictures loop-compose-*.png.
    Timer {
        running: Qt.application.arguments.indexOf("--loop-compose-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        property int waited: 0
        property string sentText: "OST TEST 85 loop from OST"
        property bool linkDone: false
        property bool switchDone: false
        function ch0() { return chatList.chats.find(x => x.name === "OST group test").id }
        onTriggered: {
            const cap = tag => window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-loop-compose-" + tag + ".png")))
            const log = (...a) => console.warn("LOOPCOMPOSE", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const c = conversation.composeForTest()
            const args = Qt.application.arguments
            const page = () => { const lc = c.loopCardForTest(); return lc ? lc.page : null }
            switch (step) {
            case 0: {
                const open = args.find(a => a.startsWith("--open-chat="))
                const ch = open ? { id: open.slice(12), name: "" } : chatList.chats.find(x => x.name === "OST group test")
                backend.selectChat(ch.id, ch.name); break
            }
            case 2: log("allowed", c.loopAllowed, "tools", c.toolModel.map(t => t.id)); c.toolClicked("popup-semo", null); break
            case 3: cap("inserted"); break
            case 4: {
                const l = c.loop, p = page()
                if ((!l || !l.url) && !(l && l.error) && waited++ < 40) return
                waited = 0
                log("made", { url: l ? l.url.split("?")[0] : "", description: l ? l.description : "", error: l ? l.error || "" : "nothing", events: p ? p.events : [] })
                cap("made")
                if (!l || !l.url) { Qt.quit(); return }
                break
            }
            // --loop-compose-title: a title first (the file is named after it).
            case 5: if (args.indexOf("--loop-compose-title") >= 0) page().typeTitleForTest("OST TEST 85 titled from OST"); break
            case 7: page().typeForTest("OST TEST 85 loop OST\nLoop body typed in OST"); break
            case 9: { const p = page(); p.textForTest(t => log("typed", t.slice(0, 200))); log("title", c.loop.title); cap("typed"); break }
            case 10: {
                // --loop-compose-link: the description opens Link settings
                // (Teams' three choices); People currently in this chat is
                // applied and the header names it.
                if (args.indexOf("--loop-compose-link") >= 0 && !linkDone) { c.openLoopLinkSettings(); step = 50; return }
                // --loop-compose-switch: leaving the chat drops the draft
                // (Teams keeps no draft with a Loop component in it).
                if (args.indexOf("--loop-compose-switch") >= 0 && !switchDone) {
                    const other = chatList.chats.find(x => x.name !== "OST group test" && !x.id.startsWith("48:"))
                    backend.selectChat(other.id, other.name); step = 60; return
                }
                if (args.indexOf("--loop-compose-discard") >= 0) { c.loopDiscardDialogForTest().open(); break }
                if (args.indexOf("--loop-compose-send") < 0) { log("left in the box (not sent)"); Qt.quit(); return }
                conversation.setComposeText(sentText); break
            }
            case 11: {
                if (args.indexOf("--loop-compose-discard") >= 0) { cap("discard-dialog"); c.loopDiscardDialogForTest().confirmed(); c.loopDiscardDialogForTest().close(); break }
                log("check", c.preSendCheck() || "fine"); conversation.sendForTest(); break
            }
            case 13: if (args.indexOf("--loop-compose-discard") >= 0) { log("discarded; box", !!c.loop); cap("discarded"); Qt.quit(); return } break
            case 18: {
                const m = (conversation.messages || []).filter(x => (x.cards || []).some(k => k.content_type === "application/vnd.microsoft.card.fluidEmbedCard")).pop()
                log("sent", m ? { id: m.id, html: String(m.html || "").slice(0, 300), card: m.cards[0].content } : null)
                conversation.jumpToNewest(); break
            }
            case 26: cap("sent"); Qt.quit(); return
            case 50: {
                const d = conversation.cloudAttachForTest().linkDialogForTest()
                if (!d.opened) { if (waited++ < 10) return; log("link settings didn't open"); Qt.quit(); return }
                waited = 0
                cap("link-settings"); log("link dialog", { file: d.fileName, hidden: d.hiddenScopes })
                d.pendScope = 4; d.linkChosen(4, true, "", ""); d.close()
                step = 52; return
            }
            case 52: {
                if (c.loop.linking && waited++ < 30) return
                waited = 0
                log("relinked", { description: c.loop.description, url: c.loop.url.split("?")[0], share: c.loop.shareId || "" })
                cap("relinked"); linkDone = true; step = 10; return
            }
            case 60: { const ch = chatList.chats.find(x => x.name === "OST group test"); backend.selectChat(ch.id, ch.name); step = 61; return }
            case 61: case 62: step++; return
            case 63: log("after switch", { loop: !!c.loop, draft: backend.draftJson(ch0()) || "none" }); cap("switched"); switchDone = true; Qt.quit(); return
            }
            step++
        }
    }

    // --recap-window-test[=transcript|thumbnail|link|highlights|extras|template]:
    // in "Event group: OST TEST 217 town hall 2", the recap card's transcript
    // chip (or thumbnail) opens Teams' recap window (RECAPWIN lines,
    // recap-window.png of that window); =link copies the recap link (Share >
    // Copy link); =highlights opens Events on the event; =template goes
    // through Custom summary's Create template: the editor, a blank Preview,
    // a suggestion, a Preview of a description, Save and Apply as "OST TEST
    // 240 template" (a bad name first), Rename, Edit, the card's menu, Share
    // (the text copied), then Delete (also of any template left from an
    // earlier run), each logged and shot (recap-template-*.png).
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--recap-window-test")) && backend.signedIn && chatList.chats.some(c => c.name.indexOf(recapChat) >= 0)
        interval: 2000; repeat: true
        // --recap-chat=<name> (~ for spaces): another meeting chat.
        readonly property string recapChat: (Qt.application.arguments.find(a => a.startsWith("--recap-chat=")) || "").slice(13).replace(/~/g, " ") || "OST TEST 217 town hall 2"
        property string chosen: ""
        property int step: 0
        property int waited: 0
        property string tplId: ""
        readonly property string tplName: "OST TEST 240 template"
        readonly property string tplText: "OST TEST 240: list the decisions made, then the action items with their owners and due dates."
        readonly property string tplText2: "OST TEST 240 edited: a short overview, then the decisions made, then the action items with owners."
        onTriggered: {
            const log = (...a) => console.warn("RECAPWIN", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const mode = (Qt.application.arguments.find(a => a.startsWith("--recap-window-test")) || "").split("=")[1] || "transcript"
            const ended = () => (conversation.messages || []).find(m => m.recap && ((m.recap.recordings || []).length || m.recap.transcript))
            switch (step) {
            case 0: { const ch = chatList.chats.find(x => x.name.indexOf(recapChat) >= 0); chosen = ch.id; log("chat", ch.name, ch.id); backend.selectChat(ch.id, ch.name); break }
            case 3: {
                // The chat's own messages (not the one open before).
                const m = backend.currentChatId === chosen ? ended() : null
                if (!m && waited++ < 15) return
                waited = 0
                if (!m) { log("no recap card"); Qt.quit(); return }
                log("card", { subject: m.recap.subject, recordings: (m.recap.recordings || []).length, transcript: m.recap.transcript, call: m.call_id })
                if (mode === "link") { conversation.recapShareForTest().copyLink(conversation.recapRef(m, m.recap)); step = 20; return }
                if (mode === "highlights") { conversation.openEventHighlights(m.recap.subject, new Date(m.recap.start).getTime()); step = 30; return }
                conversation.openRecap(m, m.recap, mode === "transcript" ? "transcript" : "")
                break
            }
            case 4: {
                const w = conversation.lastRecapWindow
                if (w && JSON.parse(w.stateForTest()).loading && waited++ < 30) return
                waited = 0
                log("window", w ? JSON.parse(w.stateForTest()) : null)
                break
            }
            case 8: {
                const w = conversation.lastRecapWindow
                if (w) w.contentItem.grabToImage(r => { r.saveToFile(window.shotPath.replace(".png", "-recap-window.png")); log("shot") })
                break
            }
            case 10:
                if (mode === "template") { step = 40; return }
                if (mode !== "extras") { if (conversation.lastRecapWindow) conversation.lastRecapWindow.close(); Qt.quit(); return }
                break
            // =extras: the recap window's extras (Clipchamp, Copilot,
            // Manage, Custom summary, Mentions, Notes), each logged and shot.
            case 11: case 13: case 16: case 18: case 21: {
                const w = conversation.lastRecapWindow
                if (!w) { Qt.quit(); return }
                const n = { 11: "mentions", 13: "custom", 16: "summary", 18: "manage", 21: "copilot" }[step]
                log(n, w.extrasForTest())
                w.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-recap-" + n + ".png")))
                if (step === 21) { w.close(); Qt.quit(); return }
                break
            }
            case 9: if (mode === "extras" && conversation.lastRecapWindow) conversation.lastRecapWindow.pillForTest("Mentions"); break
            case 12: if (conversation.lastRecapWindow) conversation.lastRecapWindow.pillForTest("CustomSummary"); break
            case 14: if (conversation.lastRecapWindow) conversation.lastRecapWindow.summarizeForTest("SpeakersBasedRecap"); break
            case 17: if (conversation.lastRecapWindow) conversation.lastRecapWindow.manageForTest(); break
            case 19: if (conversation.lastRecapWindow) conversation.lastRecapWindow.copilotForTest(); break
            case 22: Qt.quit(); return
            // =template.
            case 40: case 41: case 42: case 43: case 44: case 45: case 46: case 47: case 48: case 49:
            case 50: case 51: case 52: case 53: case 54: case 55: case 56: case 57: case 58: case 59:
            case 60: case 61: case 62: case 63: case 64: case 65: case 66: case 67: case 68: case 69:
            case 70: case 71: case 72: case 73: case 74: case 75: case 76: case 77: case 78: case 79: {
                const w = conversation.lastRecapWindow
                if (!w) { log("no window"); Qt.quit(); return }
                const st = () => JSON.parse(w.templatesForTest())
                const ed = w.templateEditorForTest()
                const shot = n => w.contentItem.grabToImage(r => { r.saveToFile(window.shotPath.replace(".png", "-recap-template-" + n + ".png")); log("shot", n) })
                const mine = () => (st().templates || []).filter(x => String(x.name).indexOf(tplName) === 0)
                // Wait (2 s a tick) for `ok`, at most `n` ticks.
                const until = (ok, n) => { if (ok()) { waited = 0; return true } if (waited++ < n) return false; waited = 0; log("timed out at", step); step = 78; return false }
                switch (step) {
                case 40: w.pillForTest("CustomSummary"); break
                case 41: if (!until(() => st().templates !== null, 15)) return; log("templates", st()); shot("cards"); break
                // Templates left from an earlier run go first.
                case 42: { const old = mine(); if (old.length) log("leftover", old); for (const t of old) w.templateActionForTest("delete", t.id); break }
                case 43: if (!until(() => mine().length === 0, 15)) return; ed.openNew(st().templates); break
                case 44: log("editor", ed.stateForTest()); shot("editor"); break
                case 45: ed.preview(); log("blank preview", ed.stateForTest().error); shot("blank"); break
                case 46: ed.suggestionForTest(1); log("suggestion", ed.stateForTest().text); shot("suggestion"); break
                case 47: ed.typeForTest(tplText); ed.preview(); log("preview", ed.stateForTest().preview); break
                case 48: if (!until(() => ed.stateForTest().preview !== "generating", 45)) return; log("previewed", ed.stateForTest()); shot("preview"); break
                case 49: ed.saveAndApply(); break
                case 50: { const nd = ed.nameDialogForTest(); log("name dialog", nd.stateForTest()); nd.typeForTest("OST:240"); log("bad name", nd.stateForTest().error); shot("name-bad"); break }
                case 51: { const nd = ed.nameDialogForTest(); nd.typeForTest(tplName); log("name", nd.stateForTest()); shot("name"); break }
                case 52: ed.nameDialogForTest().save(); break
                case 53: if (!until(() => !ed.stateForTest().opened && mine().length > 0, 20)) return; tplId = mine()[0].id; log("saved", tplId, st()); break
                case 54: shot("saved"); break
                case 55: w.templateActionForTest("rename", tplId); break
                case 56: { const rd = w.renameDialogForTest(); log("rename dialog", rd.stateForTest()); rd.typeForTest(tplName + " renamed"); shot("rename"); break }
                case 57: w.renameDialogForTest().save(); break
                case 58: if (!until(() => (st().templates || []).some(x => x.id === tplId && x.name === tplName + " renamed"), 15)) return; log("renamed", st().order); break
                case 59: w.templateActionForTest("edit", tplId); break
                case 60: if (!until(() => !ed.stateForTest().loading, 15)) return; log("edit text", ed.stateForTest().text === tplText, ed.stateForTest().edit); shot("edit"); break
                case 61: ed.typeForTest(tplText2); ed.saveAndApply(); break
                case 62: if (!until(() => !ed.stateForTest().opened, 15)) return; log("edited", st().key === tplId, st()); break
                case 63: log("menu", w.templateMenuForTest(tplId)); break
                case 64: shot("menu"); break
                case 65: w.closeTemplateMenuForTest(); w.templateActionForTest("share", tplId); break
                case 66: if (!until(() => st().shared !== "", 15)) return; log("shared", st().shared === tplText2); shot("shared"); break
                case 67: w.templateActionForTest("delete", tplId); break
                case 68: if (!until(() => !(st().templates || []).some(x => x.id === tplId), 15)) return; log("deleted", st()); tplId = ""; shot("deleted"); break
                case 69: w.close(); Qt.quit(); return
                // Timed out: the test template is deleted all the same.
                case 78: { const t = tplId || (mine()[0] || {}).id; if (t) { log("cleanup", t); w.templateActionForTest("delete", t) } break }
                case 79: log("end", st()); w.close(); Qt.quit(); return
                default: break
                }
                break
            }
            case 33: {
                const ev = eventsView.item
                log("events", ev ? ev.stateForTest() : "no view")
                window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-recap-highlights.png")))
                break
            }
            case 35: Qt.quit(); return
            }
            step++
        }
    }

    // --card-action-test=<button title>[|<input id>=<value>]: in OST group
    // test (or --open-chat=<id>), the newest bot card with that button is
    // pressed as a person would (its inputs filled), and what Teams shows
    // under the card afterwards is logged (CARDACTION lines, card-action.png).
    Timer {
        running: Qt.application.arguments.some(a => a.startsWith("--card-action-test=")) && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        property string key: ""
        onTriggered: {
            const log = (...a) => console.warn("CARDACTION", ...a.map(x => typeof x === "string" ? x : JSON.stringify(x)))
            const spec = Qt.application.arguments.find(a => a.startsWith("--card-action-test=")).slice(19).split("|")
            const title = spec[0]
            const inputs = {}
            for (const kv of spec.slice(1)) { const i = kv.indexOf("="); if (i > 0) inputs[kv.slice(0, i)] = kv.slice(i + 1) }
            switch (step) {
            case 0: {
                const open = Qt.application.arguments.find(a => a.startsWith("--open-chat="))
                const ch = open ? { id: open.slice(12), name: "" } : chatList.chats.find(x => x.name === "OST group test")
                backend.selectChat(ch.id, ch.name); break
            }
            case 3: {
                const ms = (conversation.messages || []).filter(m => (m.cards || []).some(c => ((c.content || {}).actions || []).some(a => a.title === title)))
                const m = ms.pop()
                if (!m) { log("no card with", title); Qt.quit(); return }
                const index = m.cards.findIndex(c => ((c.content || {}).actions || []).some(a => a.title === title))
                key = m.id + ":" + index
                log("press", title, inputs, conversation.cardActionForTest(m.id, index, title, inputs) || "")
                break
            }
            case 9: log("footer", conversation.cardFooters[key] || null); conversation.jumpToNewest(); break
            case 11: window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-card-action.png"))); log("newest", (conversation.messages || []).slice(-2).map(m => ({ from: m.sender, text: String(m.text || "").slice(0, 160) }))); break
            case 12: Qt.quit(); return
            }
            step++
        }
    }

    // --compose-height-test: in OST group test, 30 lines in the compose box
    // (Teams' box stops at its 270 px editor and scrolls); COMPOSEHEIGHT
    // line with the box's and the text's heights, compose-height.png; the
    // box is cleared again.
    Timer {
        running: Qt.application.arguments.indexOf("--compose-height-test") >= 0 && backend.signedIn && chatList.chats.some(c => c.name === "OST group test")
        interval: 2000; repeat: true
        property int step: 0
        onTriggered: {
            const c = conversation.composeForTest()
            switch (step) {
            case 0: { const ch = chatList.chats.find(x => x.name === "OST group test"); backend.selectChat(ch.id, ch.name); break }
            case 2: { let t = ""; for (let i = 1; i <= 30; i++) t += (i > 1 ? "<br>" : "") + "OST_TEST_203_line_" + i; c.focusEditor(); c.insertText(t); break }
            case 3: {
                const p = c.mapToItem(window.contentItem, 0, 0)
                console.warn("COMPOSEHEIGHT", JSON.stringify({ box: { x: p.x, y: p.y, w: c.width, h: c.height }, window: [window.width, window.height] }))
                window.contentItem.grabToImage(r => r.saveToFile(window.shotPath.replace(".png", "-compose-height.png")))
                break
            }
            case 4: c.clear(); backend.setDraft(backend.currentChatId, ""); break
            case 5: Qt.quit(); return
            }
            step++
        }
    }


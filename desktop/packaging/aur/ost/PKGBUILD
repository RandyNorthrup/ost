# Maintainer: Randy Northrup <randy.northrup@gmail.com>
#
# Kept in https://github.com/RandyNorthrup/ost as
# desktop/packaging/aur/ost/PKGBUILD; the release workflow sets pkgver and
# sha256sums for each release and pushes it here.

pkgname=ost
pkgver=0.2.1
pkgrel=1
pkgdesc='Native Linux desktop client for Microsoft Teams: chat, channels, calls and meetings, calendar and files (unofficial)'
arch=('x86_64')
url='https://github.com/RandyNorthrup/ost/wiki'
license=('MIT')
depends=(
  'alsa-lib'
  'ffmpeg'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libpipewire'
  'libstdc++'
  'openssl'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-svg'
  'qt6-wayland'
  'qt6-webchannel'
  'qt6-webengine'
  'webrtc-audio-processing-1'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'lld'
  'nasm'
  'pkgconf'
  'qt6-shadertools'
)
optdepends=(
  'layer-shell-qt: Teams-style notification banners on Wayland'
  'org.freedesktop.secrets: keep the sign-in in the desktop keyring (GNOME Keyring or KWallet)'
  'pipewire: call audio and screen sharing'
  'xdg-desktop-portal: screen and window sharing through your desktop portal'
)
provides=('teams-cli')
conflicts=('ost-bin' 'teams-cli')
# makepkg's LTO turns the C++ objects (cxx-qt, the Qt and WebRTC bridges)
# into GCC bitcode that the Rust link can't read.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/RandyNorthrup/ost/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export QMAKE=/usr/bin/qmake6
  cargo build --frozen --release -p ost-desktop
  cargo build --frozen --release --bin teams-cli --features audio
}

package() {
  cd "$pkgname-$pkgver"
  local id=io.github.RandyNorthrup.ost
  install -Dm755 target/release/ost-desktop "$pkgdir/usr/bin/ost-desktop"
  install -Dm755 target/release/teams-cli "$pkgdir/usr/bin/teams-cli"
  install -Dm644 "desktop/packaging/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "desktop/packaging/$id.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$id.png"
  install -Dm644 "desktop/packaging/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
  # Bluetooth headset answer and hang-up buttons need a one-time PipeWire
  # setup: sh /usr/share/ost/packaging/install-hfp-calls.sh
  install -Dm644 -t "$pkgdir/usr/share/$pkgname/packaging" \
    desktop/packaging/install-hfp-calls.sh \
    desktop/packaging/ost-hfp-calls.dbus.conf \
    desktop/packaging/ost-hfp-calls.wireplumber.conf
}

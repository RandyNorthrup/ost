<?xml version="1.0" encoding="UTF-8"?>
<!-- OST's AppStream metainfo: the .deb, .rpm, AUR packages, Flatpak and
     AppImage all install it as /usr/share/metainfo/<id>.metainfo.xml. -->
<component type="desktop-application">
  <id>io.github.RandyNorthrup.ost</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>OST</name>
  <summary>Desktop client for Microsoft Teams</summary>
  <developer id="io.github.randynorthrup">
    <name>Randy Northrup</name>
  </developer>
  <description>
    <p>
      Native Linux desktop client for Microsoft Teams: chat, channels, calls
      and meetings, calendar and files, built in Rust and Qt Quick. It looks
      and works like the Teams desktop app; only the name and the logo differ.
      It also includes the terminal client, teams-cli.
    </p>
    <p>
      OST is unofficial and not affiliated with Microsoft. You sign in with
      your own Microsoft work or school account.
    </p>
    <ul>
      <li>Chats with Teams' formatting, code blocks, emoji, GIFs, reactions, files, Loop components, video clips and scheduled messages</li>
      <li>Teams and channels: posts, threads, announcements, channel tabs, shared and private channels</li>
      <li>Calls and meetings with video, background effects, screen sharing, live captions, recording, breakout rooms and webinars</li>
      <li>Calendar with day, work week, week and month views and Teams' scheduling form</li>
      <li>OneDrive and channel files, previews and sharing</li>
      <li>Activity, notifications with quick reply, presence, Teams' Settings, light, dark and high-contrast themes</li>
      <li>Teams Rooms: run as a room device, cast to a room or control one</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.RandyNorthrup.ost.desktop</launchable>
  <icon type="stock">io.github.RandyNorthrup.ost</icon>
  <url type="homepage">https://github.com/RandyNorthrup/ost/wiki</url>

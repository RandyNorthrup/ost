--- a/spa/plugins/bluez5/backend-native.c
+++ b/spa/plugins/bluez5/backend-native.c
@@ -126,6 +126,8 @@
 	unsigned int battery_level;
 
 	void *modemmanager;
+	/* The bus the modem (call provider) is on, when not the system bus. */
+	struct spa_dbus_connection *modem_dbus_connection;
 	struct spa_source *ring_timer;
 	void *upower;
 	struct spa_bt_telephony *telephony;
@@ -4037,6 +4039,7 @@
 		mm_unregister(backend->modemmanager);
 		backend->modemmanager = NULL;
 	}
+	spa_clear_ptr(backend->modem_dbus_connection, spa_dbus_connection_destroy);
 
 	if (backend->upower) {
 		upower_unregister(backend->upower);
@@ -4234,7 +4237,23 @@
 	}
 #endif
 
-	backend->modemmanager = mm_register(backend->log, backend->conn, info, &mm_ops, backend);
+	{
+		/* A softphone on the session bus can provide the calls (ModemManager's
+		 * Voice API) instead of a modem on the system bus. */
+		DBusConnection *modem_conn = backend->conn;
+		const char *bus = info ? spa_dict_lookup(info, "bluez5.hfphsp-backend-native-modem-bus") : NULL;
+
+		if (bus && spa_streq(bus, "session")) {
+			backend->modem_dbus_connection = spa_dbus_get_connection(backend->dbus, SPA_DBUS_TYPE_SESSION);
+			if (backend->modem_dbus_connection)
+				modem_conn = spa_dbus_connection_get(backend->modem_dbus_connection);
+			if (modem_conn == NULL) {
+				spa_log_warn(backend->log, "no session bus for the modem, using the system bus");
+				modem_conn = backend->conn;
+			}
+		}
+		backend->modemmanager = mm_register(backend->log, modem_conn, info, &mm_ops, backend);
+	}
 	backend->upower = upower_register(backend->log, backend->conn, set_battery_level, backend);
 	backend->telephony = telephony_new(backend->log, backend->dbus, info);
 
